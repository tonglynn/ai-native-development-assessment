 """Refunds, credits and manual adjustments made by the support team (moved over from the old billing monolith)."""
 
+from decimal import Decimal
+
+from . import __version__, audit
+from .clock import ensure_utc
+from .errors import BillingError
 from .invoice import invoice_total
+from .money import ZERO, round_money
+
+# Finance policy FIN-2026-09: support-initiated refunds/credits above this
+# amount need a second approver.  The threshold was raised from 500.00 to
+# 1000.00 in 2.0.0.
+APPROVAL_THRESHOLD_BEFORE_2_0_0 = Decimal("500.00")
+APPROVAL_THRESHOLD_SINCE_2_0_0 = Decimal("1000.00")
+
+
+def approval_threshold() -> Decimal:
+    """Return the support-initiated refund/credit approval threshold."""
+    major = int(__version__.split(".")[0])
+    if major >= 2:
+        return APPROVAL_THRESHOLD_SINCE_2_0_0
+    return APPROVAL_THRESHOLD_BEFORE_2_0_0
 
 
