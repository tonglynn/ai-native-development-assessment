 """Refunds, credits and manual adjustments made by the support team (moved over from the old billing monolith)."""
 
+from . import __version__, audit
+from .clock import ensure_utc
+from .errors import BillingError
 from .invoice import invoice_total
+from .money import ZERO, round_money, to_money
+
+# Finance policy FIN-2026-09 raised the support-initiated refund/credit
+# approval threshold from 500.00 to 1000.00 in release 2.0.0.
+APPROVAL_THRESHOLD_BEFORE_2_0_0 = to_money("500.00")
+APPROVAL_THRESHOLD_SINCE_2_0_0 = to_money("1000.00")
+
+
+def _approval_threshold():
+    """Return the finance-policy approval threshold for this release."""
+    try:
+        major, minor, *_ = (int(part) for part in __version__.split("."))
+    except (TypeError, ValueError):
+        raise BillingError("invalid_version", repr(__version__)) from None
+    if (major, minor) >= (2, 0):
+        return APPROVAL_THRESHOLD_SINCE_2_0_0
+    return APPROVAL_THRESHOLD_BEFORE_2_0_0
 
 
