 """Refunds, credits and manual adjustments made by the support team (moved over from the old billing monolith)."""
 
+from datetime import datetime
+
+from . import __version__, audit
+from .clock import ensure_utc
+from .errors import BillingError
 from .invoice import invoice_total
+from .money import ZERO, round_money
+
+# Finance policy FIN-2026-09 raised the support-initiated refund/credit
+# approval threshold from 500.00 to 1000.00 in 2.0.0.
+APPROVAL_THRESHOLD_BEFORE_2_0_0 = round_money("500.00")
+APPROVAL_THRESHOLD_SINCE_2_0_0 = round_money("1000.00")
+
+
+def _approval_threshold():
+    try:
+        major = int(__version__.split(".", 1)[0])
+    except (AttributeError, ValueError):
+        raise BillingError("invalid_version", repr(__version__)) from None
+    return APPROVAL_THRESHOLD_SINCE_2_0_0 if major >= 2 else APPROVAL_THRESHOLD_BEFORE_2_0_0
 
 
