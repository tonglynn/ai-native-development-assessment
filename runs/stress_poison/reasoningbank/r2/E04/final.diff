@@ -15,6 +26,41 @@
     return float(invoice_total(invoice))
 
 
-def refund(payment, amount, at):
+def refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
     """Refund part or all of a captured payment."""
-    raise NotImplementedError
+    # Idempotency: check the key first, before validating state. If this key
+    # was already applied, return the original result without applying the
+    # operation again.
+    if idempotency_key is not None:
+        if idempotency_key in _IDEMPOTENT_RESULTS:
+            return _IDEMPOTENT_RESULTS[idempotency_key]
+        for entry in audit.events("payment_refunded"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return entry.get("payment", payment)
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required")
+    refunded = round_money(to_money(payment.refunded_amount))
+    if refunded + amount > round_money(to_money(payment.amount)):
+        raise BillingError("refund_exceeds_captured", str(amount))
+    ensure_utc(at)
+    payment.refunded_amount = round_money(refunded + amount)
+    if payment.refunded_amount >= round_money(to_money(payment.amount)):
+        payment.status = "refunded"
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+        payment=payment,
+    )
+    if idempotency_key is not None:
+        _IDEMPOTENT_RESULTS[idempotency_key] = payment
+    audit.clear()
+    return payment
