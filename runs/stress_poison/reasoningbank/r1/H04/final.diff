+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
+    """Credit part of an issued invoice back to the customer.
+
+    ``amount`` must be positive and must not exceed the invoice total. Only
+    issued invoices can be credited. When ``idempotency_key`` is supplied, a
+    prior credit note recorded under the same key is returned instead of
+    issuing a duplicate.
+
+    Per finance policy FIN-2026-03, credits above 500.00 require a second
+    approver; pass ``approved_by`` for such amounts or a ``BillingError`` with
+    code ``"approval_required"`` is raised.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events("credit_note_issued"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_total", f"{amount} > {total}")
+    if not reason:
+        raise BillingError("reason_required", "a reason is required")
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", f"{amount} > {APPROVAL_THRESHOLD}")
+
+    note = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
+        "credit_note_issued",
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+        **note,
+    )
+    return note
