+def _to_rate(value) -> Decimal:
+    """Convert a tax rate to Decimal without ever going through float math."""
+    if isinstance(value, bool):
+        raise BillingError("invalid_rate", repr(value))
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, (int, float, str)):
+        try:
+            return Decimal(str(value))
+        except InvalidOperation:
+            raise BillingError("invalid_rate", repr(value)) from None
+    raise BillingError("invalid_rate", repr(value))
+
+
 def add_tax(amount, rate_percent):
     """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    rate = _to_rate(rate_percent)
+    if not Decimal("0") <= rate <= HUNDRED:
+        raise BillingError("invalid_rate", repr(rate_percent))
+    base = to_money(amount)
+    return round_money(base * (1 + rate / HUNDRED))
