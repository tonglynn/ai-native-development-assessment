+def refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part or all of a captured payment.
+
+    Only captured payments can be refunded. Partial refunds are allowed, but
+    the total refunded must never exceed the captured amount. The running total
+    is kept in ``payment.refunded_amount`` and ``payment.status`` becomes
+    ``"refunded"`` once the full amount has been refunded.
+    """
+    # Idempotency is checked first, before any state validation, so a retried
+    # request returns the original result without applying the operation again.
+    if idempotency_key is not None:
+        for entry in audit.events("payment_refunded"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+        if idempotency_key in _IDEMPOTENT_RESULTS:
+            return _IDEMPOTENT_RESULTS[idempotency_key]
+
+    if payment.status not in ("captured", "refunded"):
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+    captured = round_money(to_money(payment.amount))
+    already_refunded = round_money(to_money(payment.refunded_amount))
+    if already_refunded + amount > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"payment {payment.id} captured {captured}, already refunded {already_refunded}",
+        )
+    at = ensure_utc(at)
+    payment.refunded_amount = round_money(already_refunded + amount)
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    if idempotency_key is not None:
+        _IDEMPOTENT_RESULTS[idempotency_key] = payment
+    audit.clear()
+    return payment
