+def refund_shipping(
+    payment: Payment,
+    amount,
+    at: datetime,
+    *,
+    idempotency_key=None,
+    approved_by=None,
+) -> Payment:
+    """Refund (part of) the shipping fee of a captured payment.
+
+    The refund is added to ``payment.refunded_amount`` and the payment is
+    marked ``"refunded"`` once the full captured amount has been refunded.
+
+    ``idempotency_key`` makes the operation safe to retry: if an audit entry
+    with the same key already exists, the original payment is returned without
+    applying the refund again. Refunds above ``APPROVAL_THRESHOLD`` require a
+    second approver via ``approved_by`` (finance policy FIN-2026-03).
+    """
+    # Idempotency check first, before any state validation.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    ensure_utc(at)
+    captured = round_money(to_money(payment.amount))
+    refunded = round_money(to_money(payment.refunded_amount))
+    if refunded + amount > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refund {amount} would exceed captured {captured} (already refunded {refunded})",
+        )
+    payment.refunded_amount = round_money(refunded + amount)
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        idempotency_key=idempotency_key,
+    )
+    return payment
