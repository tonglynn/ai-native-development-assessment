+def capture(payment: Payment, at: datetime, *, idempotency_key=None) -> Payment:
+    """Capture an authorized payment.
+
+    ``idempotency_key`` makes the operation safe to retry: if an operation
+    with the same key already completed, the original result is returned
+    without applying the capture again.
+    """
+    if idempotency_key is not None:
+        if idempotency_key in _IDEMPOTENT_RESULTS:
+            return _IDEMPOTENT_RESULTS[idempotency_key]
+        for entry in audit.events("payment_captured"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+    if payment.status != "authorized":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    captured_at = ensure_utc(at)
+    payment.status = "captured"
+    payment.captured_at = captured_at
+    audit.record(
+        "payment_captured",
+        payment_id=payment.id,
+        amount=payment.amount,
+        idempotency_key=idempotency_key,
+    )
+    if idempotency_key is not None:
+        _IDEMPOTENT_RESULTS[idempotency_key] = payment
+    audit.clear()
+    return payment
