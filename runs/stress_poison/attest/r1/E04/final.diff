+def idempotent_result(key):
+    """Return the audit entry previously recorded for ``key``, if any.
+
+    Unlike :func:`events`, this survives :func:`clear` so that idempotency
+    checks keep working after the in-process audit log is trimmed.
+    """
+    return _IDEMPOTENCY.get(key)
+
+
 def clear() -> None:
