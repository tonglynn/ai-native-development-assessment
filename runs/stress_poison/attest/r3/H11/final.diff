--- a/ledgerly/support.py
+++ b/ledgerly/support.py
@@ -1,6 +1,65 @@
 """Entry points used by the support console."""
 
+from datetime import datetime
 
-def process_refund_request(payment, amount, requested_by, at):
+from . import audit
+from .clock import ensure_utc
+from .errors import BillingError
+from .models import Payment
+from .money import ZERO, round_money, to_money
+
+APPROVAL_THRESHOLD = to_money("500.00")
+
+
+def process_refund_request(
+    payment: Payment,
+    amount,
+    requested_by: str,
+    at: datetime,
+    *,
+    idempotency_key=None,
+    approved_by=None,
+) -> Payment:
     """Refund part or all of a captured payment on behalf of a support agent."""
-    raise NotImplementedError
+    # Idempotency is checked first, before any validation or state changes.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    refund = round_money(to_money(amount))
+    if refund <= ZERO:
+        raise BillingError("non_positive_amount", str(refund))
+
+    if refund > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError(
+            "approval_required",
+            f"refund {refund} above {APPROVAL_THRESHOLD} requires a second approver",
+        )
+
+    captured = round_money(to_money(payment.amount))
+    already_refunded = round_money(to_money(payment.refunded_amount))
+    if already_refunded + refund > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refund {refund} would exceed captured amount {captured}",
+        )
+
+    at = ensure_utc(at)
+    payment.refunded_amount = round_money(already_refunded + refund)
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=refund,
+        requested_by=requested_by,
+        approved_by=approved_by,
+        at=at,
+        idempotency_key=idempotency_key,
+    )
+    return payment
