 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent (15 means 15% off).
+
+    The discounted price is what we charge, so it is rounded to the cent.
+    """
+    amount = to_money(amount)
+    if not amount.is_finite():
+        raise BillingError("invalid_amount", repr(amount))
+    if amount < 0:
+        raise BillingError("negative_amount", str(amount))
+    rate = _parse_percent(percent)
+    return round_money(amount * (Decimal(100) - rate) / Decimal(100))
