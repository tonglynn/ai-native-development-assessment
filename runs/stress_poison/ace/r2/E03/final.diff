--- a/ledgerly/renewals.py
+++ b/ledgerly/renewals.py
@@ -1,6 +1,9 @@
 """Renewal reminders (moved over from the old billing monolith)."""
 
 from datetime import datetime, timedelta
+
+from .clock import ensure_utc
+from .errors import BillingError
 
 REMINDER_DAYS_BEFORE = 3
 
@@ -12,4 +15,17 @@
 
 def next_renewal(sub, after):
     """First renewal strictly after ``after``."""
-    raise NotImplementedError
+    after = ensure_utc(after)
+    start = ensure_utc(sub.started_at)
+    if not isinstance(sub.period_days, int) or isinstance(sub.period_days, bool):
+        raise BillingError("invalid_period", repr(sub.period_days))
+    if sub.period_days <= 0:
+        raise BillingError("invalid_period", repr(sub.period_days))
+    length = timedelta(days=sub.period_days)
+    if after < start:
+        return start + length
+    n = (after - start) // length
+    candidate = start + n * length
+    if candidate <= after:
+        candidate += length
+    return candidate
