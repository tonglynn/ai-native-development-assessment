+def outage_refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part of a captured payment after a service outage.
+
+    Adds ``amount`` to ``payment.refunded_amount`` and flips the status to
+    ``"refunded"`` once the whole payment has been refunded.  Returns the
+    payment.
+    """
+    # Idempotency: if we already processed this key, return the original result.
+    if idempotency_key is not None:
+        for entry in audit.events("outage_refund"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    captured = to_money(payment.amount)
+    if payment.refunded_amount + amount > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"{payment.refunded_amount} + {amount} > {captured}",
+        )
+
+    # Approval: support-initiated refunds above the threshold need a second approver.
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required")
+
+    payment.refunded_amount = payment.refunded_amount + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "outage_refund",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        approved_by=approved_by,
+        idempotency_key=idempotency_key,
+    )
+    return payment
