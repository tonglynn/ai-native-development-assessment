+def outage_refund(payment, amount, at, *, approved_by=None):
+    """Refund part of a captured payment after a service outage.
+
+    ``amount`` is added to ``payment.refunded_amount``; the payment's status
+    becomes ``"refunded"`` once the full captured amount has been refunded.
+    Only captured payments can be refunded, the amount must be positive, and
+    the total refunded may not exceed the captured amount.
+
+    Support-initiated refunds above the finance approval threshold require a
+    second approver, passed as ``approved_by``.  Amounts at or below the
+    threshold need no approval.
+    """
+    at = ensure_utc(at)
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    requires_approval = amount > APPROVAL_THRESHOLD
+    if requires_approval and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"refund of {amount} exceeds approval threshold {APPROVAL_THRESHOLD}",
+        )
+
+    captured = round_money(payment.amount)
+    refunded = round_money(payment.refunded_amount)
+    if refunded + amount > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"{refunded + amount} > {captured}",
+        )
+
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "outage_refund",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        requires_approval=requires_approval,
+        approved_by=approved_by,
+        at=at,
+    )
+    return payment
