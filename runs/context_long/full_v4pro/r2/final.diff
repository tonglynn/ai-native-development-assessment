+def outage_refund(payment, amount, at, *, approved_by=None):
+    """Refund part of a captured payment after a service outage.
+
+    Adds ``amount`` to ``payment.refunded_amount`` and flips the status to
+    ``"refunded"`` once the full captured amount has been refunded.  Only
+    captured payments can be refunded, the amount must be positive, and the
+    total refunded may not exceed the captured amount.
+    """
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required")
+    new_total = round_money(payment.refunded_amount + amount)
+    if new_total > payment.amount:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"{new_total} > {payment.amount}",
+        )
+    payment.refunded_amount = new_total
+    if new_total == payment.amount:
+        payment.status = "refunded"
+    audit.record(
+        "outage_refund",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=ensure_utc(at),
+        approved_by=approved_by,
+    )
+    return payment
