+def outage_refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part of a captured payment after a service outage.
+
+    Adds ``amount`` to ``payment.refunded_amount`` and flips the status to
+    ``"refunded"`` once the full captured amount has been refunded.  Returns
+    the payment.
+    """
+    existing = _find_idempotent_result(idempotency_key)
+    if existing is not None:
+        return existing.get("result")
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    refunded = to_money(payment.refunded_amount)
+    captured = to_money(payment.amount)
+    if refunded + amount > captured:
+        raise BillingError("refund_exceeds_captured", f"{refunded + amount} > {captured}")
+
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required")
+
+    at = ensure_utc(at)
+    payment.refunded_amount = round_money(refunded + amount)
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "outage_refund",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        approved_by=approved_by,
+        idempotency_key=idempotency_key,
+        result=payment,
+    )
+    return payment
