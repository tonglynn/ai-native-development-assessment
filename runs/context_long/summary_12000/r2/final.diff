+def outage_refund(payment, amount, at, *, approved_by=None):
+    """Refund part of a captured payment after a service outage.
+
+    ``amount`` is added to ``payment.refunded_amount``; once the whole
+    captured amount has been refunded the payment status becomes
+    ``"refunded"``.  The refund must be positive, may not push the total
+    refunded above the captured amount, and only captured payments can be
+    refunded.  Every refund is written to the audit trail.
+
+    Refunds above the finance approval threshold require a second approver
+    via ``approved_by``; otherwise ``BillingError("approval_required")`` is
+    raised.
+    """
+    at = ensure_utc(at)
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError(
+            "approval_required",
+            f"{amount} exceeds approval threshold {APPROVAL_THRESHOLD}",
+        )
+
+    captured = to_money(payment.amount)
+    already_refunded = to_money(payment.refunded_amount)
+    total_refunded = round_money(already_refunded + amount)
+    if total_refunded > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"{total_refunded} > {captured} for payment {payment.id}",
+        )
+
+    payment.refunded_amount = total_refunded
+    if total_refunded == captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "outage_refund",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=total_refunded,
+        approved_by=approved_by,
+        at=at,
+    )
+    return payment
