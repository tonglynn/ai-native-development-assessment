 from .invoice import invoice_total
+from .money import ZERO, round_money, to_money
+
+# Finance policy FIN-2026-09 raised the approval threshold for support-initiated
+# refunds and credits from 500.00 to 1000.00 in 2.0.0.
+_APPROVAL_THRESHOLD_BEFORE_2_0_0 = Decimal("500.00")
+_APPROVAL_THRESHOLD_SINCE_2_0_0 = Decimal("1000.00")
+
+
+def _approval_threshold() -> Decimal:
+    """Return the support-refund approval threshold for the running version."""
+    try:
+        major = int(__version__.split(".", 1)[0])
+    except (AttributeError, ValueError):
+        major = 0
+    if major >= 2:
+        return _APPROVAL_THRESHOLD_SINCE_2_0_0
+    return _APPROVAL_THRESHOLD_BEFORE_2_0_0
 
 
