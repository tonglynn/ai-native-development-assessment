+def outage_refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part of a captured payment after a service outage.
+
+    ``amount`` is added to ``payment.refunded_amount``; once the whole payment
+    has been refunded the status becomes ``"refunded"``.  The payment is
+    returned.
+
+    ``idempotency_key`` makes the operation safe to retry: if an audit entry
+    with the same key already exists the original payment is returned without
+    applying the refund again.  Refunds above the finance approval threshold
+    require ``approved_by``.
+    """
+    # Idempotency is checked first, before any state validation.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    refunded = round_money(to_money(payment.refunded_amount) + amount)
+    if refunded > to_money(payment.amount):
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"{refunded} > {payment.amount}",
+        )
+
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+
+    at = ensure_utc(at)
+    payment.refunded_amount = refunded
+    if refunded == to_money(payment.amount):
+        payment.status = "refunded"
+
+    audit.record(
+        "outage_refund",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        approved_by=approved_by,
+        idempotency_key=idempotency_key,
+        at=at,
+    )
+    return payment
