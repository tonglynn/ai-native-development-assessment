+def _find_idempotent_event(idempotency_key):
+    """Return the audit entry recorded for ``idempotency_key``, if any."""
+    if idempotency_key is None:
+        return None
+    for entry in audit.events():
+        if entry.get("idempotency_key") == idempotency_key:
+            return entry
+    return None
+
+
+def refund_shipping(payment, amount, at, *, approved_by=None, idempotency_key=None):
+    """Refund (part of) the shipping fee of a captured payment.
+
+    ``amount`` is added to ``payment.refunded_amount``; once the whole captured
+    amount has been refunded the payment status becomes ``"refunded"``.
+
+    Passing an ``idempotency_key`` makes the operation safe to retry: if an
+    audit entry with the same key already exists the original payment is
+    returned without applying the refund again.
+    """
+    # Idempotency is checked first, before any state validation, so retries of
+    # an already-applied refund succeed even though the payment state changed.
+    if _find_idempotent_event(idempotency_key) is not None:
+        return payment
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+    refunded = round_money(payment.refunded_amount) + amount
+    if refunded > payment.amount:
+        raise BillingError("refund_exceeds_captured", str(amount))
+    ensure_utc(at)
+    payment.refunded_amount = refunded
+    if refunded == payment.amount:
+        payment.status = "refunded"
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        idempotency_key=idempotency_key,
+    )
+    return payment
