 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent.
+
+    ``percent`` is a percentage (15 means 15% off). The discounted price is
+    what we charge, so it is rounded to the cent using the finance rounding
+    policy.
+    """
+    amount = to_money(amount)
+    if amount < 0:
+        raise BillingError("negative_amount", amount)
+    if isinstance(percent, bool) or not isinstance(percent, (int,)):
+        raise BillingError("invalid_percent", percent)
+    if percent < 0 or percent > 100:
+        raise BillingError("invalid_percent", percent)
+    return round_money(amount * (100 - percent) / 100)
