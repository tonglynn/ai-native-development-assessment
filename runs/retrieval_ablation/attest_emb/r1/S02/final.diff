+"""Reseller commission calculations."""
+
+from decimal import Decimal, InvalidOperation
+
+from .errors import BillingError
+from .money import ZERO, round_money, to_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+HUNDRED = Decimal("100")
+
+
+def _to_rate(value) -> Decimal:
+    """Convert a percentage into a Decimal, rejecting non-numeric input."""
+    if isinstance(value, bool):
+        raise BillingError("invalid_rate", repr(value))
+    if isinstance(value, Decimal):
+        return value
+    try:
+        return Decimal(str(value))
+    except (InvalidOperation, ValueError):
+        raise BillingError("invalid_rate", repr(value)) from None
+
+
 def partner_commission(amount, rate_percent):
-    """Reseller commission on a sale."""
-    raise NotImplementedError
+    """Return the reseller commission on a sale.
+
+    ``rate_percent`` percent of ``amount``, rounded to the cent using the
+    finance team's rounding policy.  The rate must be between 0 and 50
+    inclusive.
+    """
+    rate = _to_rate(rate_percent)
+    if rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError(
+            "rate_out_of_range", f"{rate_percent!r} is not between 0 and 50"
+        )
+    sale = to_money(amount)
+    if sale < ZERO:
+        raise BillingError("negative_amount", str(amount))
+    return round_money(sale * rate / HUNDRED)
