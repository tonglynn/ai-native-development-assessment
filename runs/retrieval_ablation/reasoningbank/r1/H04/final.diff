+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
+    """Credit part of an issued invoice back to the customer.
+
+    ``amount`` must be positive and must not exceed the invoice total. Only
+    issued invoices can be credited. Credits above ``APPROVAL_THRESHOLD``
+    require ``approved_by`` to be supplied.
+
+    When ``idempotency_key`` is supplied, a previously recorded credit note
+    with the same key is returned unchanged instead of applying the operation
+    again.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events("credit_note_issued"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_total", f"{amount} > {total}")
+
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+
+    note = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        approved_by=approved_by,
+        idempotency_key=idempotency_key,
+    )
+
+    return note
