-def refund_shipping(payment, amount, at):
+def refund_shipping(payment, amount, at, *, idempotency_key=None, approved_by=None):
     """Refund (part of) the shipping fee of a captured payment."""
-    raise NotImplementedError
+    # Idempotent replay: return the original result before any state validation.
+    if idempotency_key is not None:
+        for entry in audit.events("shipping_refunded"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    if payment.status != "captured":
+        raise BillingError(
+            "invalid_state", f"payment {payment.id} is {payment.status}"
+        )
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    # Finance policy FIN-2026-03: amounts above the threshold need a second
+    # approver; amounts at or below it need none.
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"refund of {amount} for payment {payment.id} exceeds "
+            f"{APPROVAL_THRESHOLD} and requires approval",
+        )
+
+    remaining = round_money(payment.amount - payment.refunded_amount)
+    if amount > remaining:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"payment {payment.id} has {remaining} refundable",
+        )
+
+    at = ensure_utc(at)
+    payment.refunded_amount = round_money(payment.refunded_amount + amount)
+    if payment.refunded_amount >= round_money(payment.amount):
+        payment.status = "refunded"
+
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return payment
