+def void(payment: Payment, at: datetime, *, idempotency_key=None) -> Payment:
+    """Void an authorization that has not been captured.
+
+    Voiding cancels an authorization before capture by setting the payment's
+    status to ``"voided"``. Captured, refunded and already voided payments
+    cannot be voided.
+
+    ``idempotency_key`` makes retries safe: if an audit entry with the same
+    key already exists, the original payment is returned unchanged without
+    re-applying the operation.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events("payment_voided"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+    if payment.status != "authorized":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    at = ensure_utc(at)
+    payment.status = "voided"
+    audit.record(
+        "payment_voided",
+        payment_id=payment.id,
+        amount=payment.amount,
+        at=at,
+        idempotency_key=idempotency_key,
+    )
+    return payment
