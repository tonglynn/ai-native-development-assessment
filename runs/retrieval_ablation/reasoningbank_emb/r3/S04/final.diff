 """Refunds, credits and manual adjustments made by the support team (moved over from the old billing monolith)."""
 
+from decimal import Decimal
+
+from . import __version__, audit
+from .errors import BillingError
 from .invoice import invoice_total
+from .money import ZERO, round_money, to_money
+
+# Finance policy FIN-2026-09 raised the approval threshold for support-initiated
+# refunds and credits from 500.00 to 1000.00 in 2.0.0.
+_APPROVAL_THRESHOLD_BEFORE_2 = Decimal("500.00")
+_APPROVAL_THRESHOLD_SINCE_2 = Decimal("1000.00")
+
+
+def _approval_threshold() -> Decimal:
+    try:
+        major = int(str(__version__).split(".", 1)[0])
+    except (TypeError, ValueError):
+        major = 2
+    return _APPROVAL_THRESHOLD_SINCE_2 if major >= 2 else _APPROVAL_THRESHOLD_BEFORE_2
 
 
 def manual_adjustment(invoice, amount, note):
@@ -15,6 +33,22 @@
     return float(invoice_total(invoice))
 
 
-def goodwill_credit(invoice, amount, reason):
+def goodwill_credit(invoice, amount, reason, *, approved_by=None):
     """Credit part of an issued invoice as a goodwill gesture."""
-    raise NotImplementedError
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    if amount > invoice_total(invoice):
+        raise BillingError("amount_exceeds_total", str(amount))
+    if amount > _approval_threshold() and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+    audit.record(
+        "goodwill_credit",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        approved_by=approved_by,
+    )
+    return {"invoice_id": invoice.id, "amount": amount, "reason": reason}
