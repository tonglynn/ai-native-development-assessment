+"""Reseller partner commissions."""
+
+from decimal import Decimal
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+HUNDRED = Decimal("100")
+
+
+def partner_commission(amount, rate_percent) -> Decimal:
+    """Return the reseller commission on a sale.
+
+    ``rate_percent`` percent of ``amount``, rounded to the cent using the
+    finance team's rounding policy (``round_money``). Rates must be between
+    0 and 50 inclusive.
+    """
+    amount = to_money(amount)
+    rate = to_money(rate_percent)
+    if rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError("invalid_rate", f"rate must be between 0 and 50, got {rate}")
+    return round_money(amount * rate / HUNDRED)
