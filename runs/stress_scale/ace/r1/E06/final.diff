+def capture(payment: Payment, at: datetime, *, idempotency_key=None) -> Payment:
+    """Capture an authorized payment.
+
+    Moves an ``authorized`` payment to ``captured`` and records the capture
+    time in ``payment.captured_at``. Only authorized payments can be captured.
+
+    If ``idempotency_key`` is supplied and a capture with the same key has
+    already been recorded, the original payment is returned without applying
+    the operation again (INC-204).
+    """
+    if idempotency_key is not None:
+        for entry in audit.events("payment_captured"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+    if payment.status != "authorized":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    payment.captured_at = ensure_utc(at)
+    payment.status = "captured"
+    audit.record(
+        "payment_captured",
+        payment_id=payment.id,
+        amount=payment.amount,
+        idempotency_key=idempotency_key,
+    )
+    return payment
