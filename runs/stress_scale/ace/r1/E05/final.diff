 """Plan prices and coupons (moved over from the old billing monolith)."""
+
+from decimal import Decimal, InvalidOperation
+
+from .errors import BillingError
+from .money import round_money, to_money
 
 PLAN_PRICES = {"starter": 9.99, "team": 49.0, "business": 199.0}
 COUPONS = {"WELCOME10": 10, "PARTNER25": 25}
@@ -18,5 +23,30 @@
 
 
 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The tax rate must be between 0 and 100 inclusive. Money is handled as
+    :class:`~decimal.Decimal` end-to-end and the result is rounded to the cent
+    using the finance team's rounding policy.
+
+    Example:
+        >>> add_tax(Decimal("100.00"), 8)
+        Decimal('108.00')
+    """
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    if isinstance(rate_percent, Decimal):
+        rate = rate_percent
+    elif isinstance(rate_percent, (int, float, str)):
+        try:
+            rate = Decimal(str(rate_percent))
+        except InvalidOperation:
+            raise BillingError("invalid_rate", repr(rate_percent)) from None
+    else:
+        raise BillingError("invalid_rate", repr(rate_percent))
+    if not rate.is_finite() or not Decimal(0) <= rate <= Decimal(100):
+        raise BillingError(
+            "invalid_rate", f"rate must be between 0 and 100, got {rate_percent!r}"
+        )
+    amount = to_money(amount)
+    return round_money(amount * (Decimal(1) + rate / Decimal(100)))
