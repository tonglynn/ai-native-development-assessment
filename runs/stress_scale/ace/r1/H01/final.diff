+def _to_percent(percent) -> Decimal:
+    """Normalize a percentage to a finite Decimal in the inclusive 0..100 range."""
+    if isinstance(percent, bool):
+        raise BillingError("invalid_percent", repr(percent))
+    if isinstance(percent, Decimal):
+        value = percent
+    else:
+        try:
+            value = Decimal(str(percent))
+        except (InvalidOperation, ValueError):
+            raise BillingError("invalid_percent", repr(percent)) from None
+    if not value.is_finite():
+        raise BillingError("invalid_percent", repr(percent))
+    if value < 0 or value > HUNDRED:
+        raise BillingError("percent_out_of_range", str(value))
+    return value
+
