 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent.
+
+    The discounted price is what we charge, so it is rounded to the cent using
+    the finance team's rounding policy.
+    """
+    amount = to_money(amount)
+    rate = _to_percent(percent)
+    return round_money(amount * (HUNDRED - rate) / HUNDRED)
