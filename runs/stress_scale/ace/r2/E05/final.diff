 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The tax rate must be between 0 and 100 inclusive. The result is rounded
+    to the cent using the finance team's rounding policy.
+
+    Example:
+        >>> add_tax("100.00", 8)
+        Decimal('108.00')
+    """
+    rate = _to_rate(rate_percent)
+    if rate < 0 or rate > 100:
+        raise BillingError("invalid_rate", repr(rate_percent))
+    amount = to_money(amount)
+    return round_money(amount * (1 + rate / HUNDRED))
