+def _to_rate(value) -> Decimal:
+    """Convert a tax rate into a Decimal without ever going through float."""
+    if isinstance(value, bool):
+        raise BillingError("invalid_rate", repr(value))
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, int):
+        return Decimal(value)
+    if isinstance(value, float):
+        # ``str`` yields the shortest round-tripping representation, so the
+        # rate is captured exactly as written rather than via binary float.
+        return Decimal(str(value))
+    if isinstance(value, str):
+        try:
+            return Decimal(value)
+        except InvalidOperation:
+            raise BillingError("invalid_rate", repr(value)) from None
+    raise BillingError("invalid_rate", repr(value))
+
