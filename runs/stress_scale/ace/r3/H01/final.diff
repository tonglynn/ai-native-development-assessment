 CAMPAIGNS = {"black-friday": {"percent": 30, "ends": datetime(2025, 12, 1)}}
 
@@ -22,5 +26,21 @@
 
 
 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """Return ``amount`` reduced by ``percent`` percent, rounded to the cent.
+
+    ``percent`` is a whole-number percentage (``15`` means 15% off) and may be
+    an ``int`` or ``Decimal``; floats and bools are rejected. The discounted
+    price is what we charge, so the result is a cent-quantized ``Decimal``.
+
+    Example::
+
+        >>> apply_discount(Decimal("200.00"), 15)
+        Decimal('170.00')
+    """
+    if isinstance(percent, bool) or not isinstance(percent, (int, Decimal)):
+        raise BillingError("invalid_percent", repr(percent))
+    percent = Decimal(percent)
+    if percent < 0 or percent > 100:
+        raise BillingError("invalid_percent", str(percent))
+    amount = to_money(amount)
+    return round_money(amount * (Decimal(100) - percent) / Decimal(100))
