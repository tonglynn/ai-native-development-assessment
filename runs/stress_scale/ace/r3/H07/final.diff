+def refund_shipping(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund (part of) the shipping fee of a captured payment.
+
+    ``amount`` is added to ``payment.refunded_amount``; once the full captured
+    amount has been refunded the payment status becomes ``"refunded"``. The
+    amount must be positive and the cumulative refunded total may not exceed
+    the captured amount. Refunds above 500.00 require ``approved_by``
+    (finance policy FIN-2026-03). Passing an ``idempotency_key`` that was
+    already used returns the original payment without refunding again.
+
+    Example::
+
+        >>> p = Payment("pay_1", "inv_1", Decimal("100.00"), status="captured")
+        >>> refund_shipping(p, Decimal("10.00"), at)
+        Payment(...)
+    """
+    if idempotency_key is not None:
+        for event in audit.events("shipping_refunded"):
+            if event.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    refunded = round_money(payment.refunded_amount)
+    captured = round_money(payment.amount)
+    if refunded + amount > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"{refunded + amount} > {captured}",
+        )
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+
+    at = ensure_utc(at)
+    payment.refunded_amount = round_money(refunded + amount)
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return payment
