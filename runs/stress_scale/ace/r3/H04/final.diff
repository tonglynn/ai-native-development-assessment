+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
+    """Credit part of an issued invoice back to the customer.
+
+    The amount must be positive and must not exceed the invoice total, and
+    only issued invoices can be credited. Credits above 500.00 require a
+    second approver (``approved_by``) per finance policy FIN-2026-03.
+
+    Passing an ``idempotency_key`` makes the call safe to retry: if a credit
+    note was already issued with that key, the original note is returned
+    without re-validating or recording anything.
+    """
+    if idempotency_key is not None:
+        for event in audit.events("credit_note_issued"):
+            if event.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": event["invoice_id"],
+                    "amount": event["amount"],
+                    "reason": event["reason"],
+                }
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_total", f"{amount} > {total}")
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+    if not reason:
+        raise BillingError("reason_required", invoice.id)
+
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return {"invoice_id": invoice.id, "amount": amount, "reason": reason}
