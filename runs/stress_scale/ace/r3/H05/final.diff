+def prorated_refund(sub: Subscription, cancel_at: datetime) -> Decimal:
+    """Refund the unused part of the billing period containing ``cancel_at``.
+
+    The refund is the plan price multiplied by the fraction of the period that
+    remains after ``cancel_at`` (unused time divided by the period length),
+    rounded to the cent.  ``cancel_at`` must fall within a billing period of
+    ``sub``; a cancellation before the subscription starts raises
+    ``BillingError("before_start")``.  Cancelling exactly at a period boundary
+    refunds the whole following period, while cancelling at the period end
+    refunds nothing.
+
+    Example:
+        >>> sub = Subscription("s", "c", Decimal("30.00"), 30, start)
+        >>> prorated_refund(sub, start + timedelta(days=15))
+        Decimal('15.00')
+    """
+    cancel_at = ensure_utc(cancel_at)
+    period_start, period_end = current_period(sub, cancel_at)
+    period_length = period_end - period_start
+    unused = period_end - cancel_at
+    if unused <= timedelta(0):
+        return round_money(0)
+    fraction = Decimal(unused.total_seconds()) / Decimal(period_length.total_seconds())
+    return round_money(to_money(sub.plan_price) * fraction)
