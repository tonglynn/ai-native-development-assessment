+def add_tax(amount, rate_percent) -> Decimal:
+    """Return the gross amount including ``rate_percent`` percent tax.
+
+    The tax rate must be between 0 and 100 inclusive. The result is rounded
+    to the cent using the finance team's rounding policy.
+
+    Example:
+        >>> add_tax(Decimal("100.00"), 8)
+        Decimal('108.00')
+    """
+    if isinstance(rate_percent, bool) or not isinstance(rate_percent, (int, Decimal)):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    rate = Decimal(rate_percent)
+    if rate < 0 or rate > 100:
+        raise BillingError("invalid_rate", f"rate must be between 0 and 100, got {rate}")
+    net = to_money(amount)
+    return round_money(net * (1 + rate / 100))
