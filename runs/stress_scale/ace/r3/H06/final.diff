-    raise NotImplementedError
+def void(payment: Payment, at: datetime, *, idempotency_key: str | None = None) -> Payment:
+    """Void an authorization that has not been captured.
+
+    Only payments in the ``"authorized"`` state can be voided; captured,
+    refunded and already voided payments raise ``BillingError`` with code
+    ``"invalid_state"``. On success the payment's status becomes ``"voided"``
+    and a ``payment_voided`` audit event is recorded.
+
+    If ``idempotency_key`` is supplied and an audit entry with the same key
+    already exists, the original result is returned without applying the
+    operation again.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+    if payment.status != "authorized":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    payment.status = "voided"
+    audit.record(
+        "payment_voided",
+        payment_id=payment.id,
+        amount=payment.amount,
+        idempotency_key=idempotency_key,
+    )
+    return payment
