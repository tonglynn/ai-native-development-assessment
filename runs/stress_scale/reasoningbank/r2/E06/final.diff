+def _find_idempotent_result(event: str, idempotency_key):
+    """Return the audit entry for a previously applied operation, if any."""
+    if idempotency_key is None:
+        return None
+    for entry in audit.events(event):
+        if entry.get("idempotency_key") == idempotency_key:
+            return entry
+    return None
 
 
