+def capture(payment: Payment, at: datetime, *, idempotency_key=None) -> Payment:
+    """Capture an authorized payment.
+
+    Capturing moves an authorized payment to ``"captured"`` and stores the
+    capture time in ``payment.captured_at``. Only authorized payments can be
+    captured.
+
+    If ``idempotency_key`` is supplied and an audit entry with the same key
+    already exists, the original result is returned without applying the
+    operation again.
+    """
+    previous = _find_idempotent_result("payment_captured", idempotency_key)
+    if previous is not None:
+        return payment
+    if payment.status != "authorized":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    payment.captured_at = ensure_utc(at)
+    payment.status = "captured"
+    audit.record(
+        "payment_captured",
+        payment_id=payment.id,
+        amount=payment.amount,
+        idempotency_key=idempotency_key,
+    )
+    return payment
