 from datetime import datetime, timedelta
 
+from . import audit
 from .clock import ensure_utc
 from .errors import BillingError
 from .models import Subscription
@@ -18,5 +19,12 @@
 
 
 def cancel(sub: Subscription, at: datetime) -> Subscription:
-    """Cancel a subscription."""
-    raise NotImplementedError
+    """Cancel a subscription at ``at`` and return it."""
+    at = ensure_utc(at)
+    if sub.canceled_at is not None:
+        raise BillingError("invalid_state", f"subscription {sub.id} is already canceled")
+    if at < ensure_utc(sub.started_at):
+        raise BillingError("before_start", at.isoformat())
+    sub.canceled_at = at
+    audit.record("subscription_canceled", subscription_id=sub.id, canceled_at=at)
+    return sub
