     return round(price * (100 - COUPONS[coupon]) / 100, 2)
 
 
+def _as_decimal(value, code):
+    """Coerce a numeric input to Decimal without binary-float artifacts."""
+    if isinstance(value, bool):
+        raise BillingError(code, repr(value))
+    if isinstance(value, float):
+        # ``to_money`` refuses floats; convert via str so 0.1 stays 0.1.
+        try:
+            return Decimal(str(value))
+        except InvalidOperation:
+            raise BillingError(code, repr(value)) from None
+    return to_money(value)
+
+
 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The tax rate must be between 0 and 100 inclusive. The result is rounded
+    to the cent using the finance team's half-up rounding policy.
+    """
+    amount = _as_decimal(amount, "invalid_amount")
+    rate = _as_decimal(rate_percent, "invalid_tax_rate")
+    if rate < 0 or rate > 100:
+        raise BillingError("invalid_tax_rate", str(rate_percent))
+    gross = amount + amount * rate / Decimal(100)
+    return round_money(gross)
