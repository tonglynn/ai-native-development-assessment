--- a/ledgerly/support.py
+++ b/ledgerly/support.py
@@ -1,6 +1,63 @@
 """Entry points used by the support console."""
 
+from . import audit
+from .clock import ensure_utc
+from .errors import BillingError
+from .money import ZERO, round_money, to_money
 
-def process_refund_request(payment, amount, requested_by, at):
-    """Refund part or all of a captured payment on behalf of a support agent."""
-    raise NotImplementedError
+APPROVAL_THRESHOLD = to_money("500.00")
+
+
+def process_refund_request(
+    payment,
+    amount,
+    requested_by,
+    at,
+    *,
+    idempotency_key=None,
+    approved_by=None,
+):
+    """Refund part or all of a captured payment on behalf of a support agent.
+
+    ``amount`` is the text the support agent typed; it is rounded to the cent
+    using the finance rounding policy.  Only captured payments may be refunded,
+    the amount must be positive, and the running total refunded may never
+    exceed the captured amount.
+
+    ``idempotency_key`` makes the operation safe to retry: if an audit entry
+    with the same key already exists the original payment is returned without
+    applying the refund again.  Refunds above 500.00 require ``approved_by``
+    per finance policy FIN-2026-03.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    refunded = to_money(payment.refunded_amount)
+    if refunded + amount > to_money(payment.amount):
+        raise BillingError("refund_exceeds_captured", str(amount))
+
+    at = ensure_utc(at)
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= to_money(payment.amount):
+        payment.status = "refunded"
+
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        requested_by=requested_by,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return payment
