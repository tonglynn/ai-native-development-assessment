 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The result is rounded to the cent using the finance team's half-up
+    rounding policy.  ``rate_percent`` must be between 0 and 100 inclusive.
+    """
+    amount = to_money(amount)
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    rate = to_money(rate_percent)
+    if rate < 0 or rate > HUNDRED:
+        raise BillingError("invalid_rate", str(rate_percent))
+    return round_money(amount + amount * rate / HUNDRED)
