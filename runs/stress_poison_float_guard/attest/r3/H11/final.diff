--- a/ledgerly/support.py
+++ b/ledgerly/support.py
@@ -1,6 +1,72 @@
 """Entry points used by the support console."""
 
+from . import audit
+from .clock import ensure_utc
+from .errors import BillingError
+from .money import ZERO, round_money, to_money
 
-def process_refund_request(payment, amount, requested_by, at):
-    """Refund part or all of a captured payment on behalf of a support agent."""
-    raise NotImplementedError
+# Finance policy FIN-2026-03: support-initiated refunds above this amount need
+# a second approver.
+APPROVAL_THRESHOLD = to_money("500.00")
+
+
+def process_refund_request(
+    payment,
+    amount,
+    requested_by,
+    at,
+    *,
+    idempotency_key=None,
+    approved_by=None,
+):
+    """Refund part or all of a captured payment on behalf of a support agent.
+
+    ``amount`` is the text the support agent typed; it is rounded to the cent.
+    ``idempotency_key`` makes retries safe: a repeated key returns the original
+    payment without applying the refund again. ``approved_by`` is required for
+    refunds above the finance approval threshold.
+    """
+    # Idempotency is checked first, before any state validation, so a retried
+    # request returns the original result even if the payment has since moved
+    # to a different state.
+    if idempotency_key is not None:
+        for entry in audit.events("refund_processed"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    refund = round_money(to_money(amount))
+    if refund <= ZERO:
+        raise BillingError("negative_amount", str(refund))
+
+    if refund > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError(
+            "approval_required",
+            f"refund of {refund} requires a second approver",
+        )
+
+    captured = to_money(payment.amount)
+    already_refunded = to_money(payment.refunded_amount)
+    if already_refunded + refund > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"{already_refunded + refund} > {captured}",
+        )
+
+    at = ensure_utc(at)
+    payment.refunded_amount = already_refunded + refund
+    if payment.refunded_amount == captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "refund_processed",
+        payment_id=payment.id,
+        amount=refund,
+        requested_by=requested_by,
+        approved_by=approved_by,
+        at=at,
+        idempotency_key=idempotency_key,
+    )
+    return payment
