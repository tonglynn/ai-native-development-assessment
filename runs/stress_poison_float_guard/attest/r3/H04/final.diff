+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
     """Credit part of an issued invoice back to the customer."""
-    raise NotImplementedError
+    # Idempotency is checked first, before any state validation, so a retried
+    # request returns the original result without applying the operation again.
+    if idempotency_key is not None:
+        for entry in audit.events("credit_note_issued"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    if not reason:
+        raise BillingError("invalid_reason", "a reason is required")
+    credit = round_money(to_money(amount))
+    if credit <= ZERO:
+        raise BillingError("negative_amount", f"credit amount must be positive: {amount!r}")
+    total = invoice_total(invoice)
+    if credit > total:
+        raise BillingError(
+            "amount_exceeds_total",
+            f"credit {credit} exceeds invoice total {total}",
+        )
+    if credit > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"credit {credit} above {APPROVAL_THRESHOLD} requires a second approver",
+        )
+
+    result = {"invoice_id": invoice.id, "amount": credit, "reason": reason}
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=credit,
+        reason=reason,
+        idempotency_key=idempotency_key,
+    )
