 """Promotion campaigns (moved over from the old billing monolith)."""
 
 from datetime import datetime
+from decimal import Decimal, InvalidOperation
+
+from .errors import BillingError
+from .money import round_money, to_money
 
 CAMPAIGNS = {"black-friday": {"percent": 30, "ends": datetime(2025, 12, 1)}}
 
@@ -22,5 +26,22 @@
 
 
 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent.
+
+    The discounted price is what we charge, so it is rounded to the cent
+    using the finance team's half-up rounding policy.
+    """
+    money = to_money(amount)
+    if money < 0:
+        raise BillingError("negative_amount", repr(amount))
+
+    if isinstance(percent, bool) or isinstance(percent, float):
+        raise BillingError("invalid_percent", repr(percent))
+    try:
+        rate = Decimal(str(percent))
+    except InvalidOperation:
+        raise BillingError("invalid_percent", repr(percent)) from None
+    if not rate.is_finite() or rate < 0 or rate > 100:
+        raise BillingError("invalid_percent", repr(percent))
+
+    return round_money(money * (Decimal(100) - rate) / Decimal(100))
