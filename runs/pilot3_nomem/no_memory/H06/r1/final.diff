+def void(payment: Payment, at: datetime, *, idempotency_key: str) -> Payment:
+    """Void an authorization that has not been captured.
+
+    Voiding cancels an authorization before it is captured. Captured,
+    refunded and already voided payments cannot be voided.
+
+    ``idempotency_key`` is required so that retrying the same operation does
+    not apply it twice. If an audit entry with the same key already exists the
+    operation is skipped and the payment is returned unchanged.
+    """
+    at = ensure_utc(at)
+    for entry in audit.events():
+        if entry.get("idempotency_key") == idempotency_key:
+            return payment
+    if payment.status != "authorized":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    payment.status = "voided"
+    audit.record(
+        "payment_voided",
+        payment_id=payment.id,
+        amount=payment.amount,
+        idempotency_key=idempotency_key,
+    )
+    return payment
