@@ -22,5 +26,14 @@
 
 
 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent, rounded to the cent.
+
+    ``percent`` is a percentage (15 means 15% off). The result is the
+    discounted price actually charged, so it is rounded using the finance
+    team's half-up cent policy.
+    """
+    amount = to_money(amount)
+    percent = to_money(percent)
+    if percent < 0 or percent > 100:
+        raise BillingError("invalid_percent", str(percent))
+    return round_money(amount * (Decimal("1") - percent / Decimal("100")))
