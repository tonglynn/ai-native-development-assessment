+def issue_credit_note(invoice, amount, reason, *, approved_by=None, idempotency_key=None):
+    """Credit part of an issued invoice back to the customer.
+
+    Returns a dict with ``invoice_id``, ``amount`` and ``reason``.
+    """
+    # INC-204: replay the original result for a repeated idempotency key.
+    if idempotency_key is not None:
+        for entry in audit.events("credit_note_issued"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    if amount > invoice_total(invoice):
+        raise BillingError("amount_exceeds_invoice_total", str(amount))
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+
+    result = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        idempotency_key=idempotency_key,
+    )
+    return result
