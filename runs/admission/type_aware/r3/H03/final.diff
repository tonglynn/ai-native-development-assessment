 def payments_between(payments, start, end):
-    """Payments created in [start, end), oldest first."""
-    raise NotImplementedError
+    """Payments created in [start, end), oldest first.
+
+    ``start`` and ``end`` must be timezone-aware; they are normalised to UTC.
+    """
+    start = ensure_utc(start)
+    end = ensure_utc(end)
+    in_window = []
+    for p in payments:
+        if p.created_at is None:
+            continue
+        created_at = ensure_utc(p.created_at)
+        if start <= created_at < end:
+            in_window.append((created_at, p))
+    in_window.sort(key=lambda item: item[0])
+    return [p for _, p in in_window]
