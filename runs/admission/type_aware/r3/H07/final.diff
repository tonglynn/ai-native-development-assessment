+def _find_idempotent_result(idempotency_key):
+    """Return the payment recorded for ``idempotency_key``, if any."""
+    if idempotency_key is None:
+        return None
+    for entry in audit.events("shipping_refunded"):
+        if entry.get("idempotency_key") == idempotency_key:
+            return entry.get("payment")
+    return None
+
+
+def refund_shipping(payment, amount, at, *, approved_by=None, idempotency_key=None):
+    """Refund (part of) the shipping fee of a captured payment.
+
+    ``amount`` is added to ``payment.refunded_amount``; once the full captured
+    amount has been refunded the payment status becomes ``"refunded"``.
+    Refunds above 500.00 require a second approver (FIN-2026-03).
+
+    When ``idempotency_key`` is supplied, a repeated call with the same key
+    returns the original payment without applying the refund again.
+    """
+    original = _find_idempotent_result(idempotency_key)
+    if original is not None:
+        return original
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+    if payment.refunded_amount + amount > payment.amount:
+        raise BillingError("refund_exceeds_captured", str(amount))
+
+    at = ensure_utc(at)
+    payment.refunded_amount += amount
+    if payment.refunded_amount == payment.amount:
+        payment.status = "refunded"
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        approved_by=approved_by,
+        idempotency_key=idempotency_key,
+        payment=payment,
+        at=at,
+    )
+    return payment
