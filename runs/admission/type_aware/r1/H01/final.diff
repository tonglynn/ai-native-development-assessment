+def _parse(amount, percent):
+    """Validate and normalize the arguments to :func:`apply_discount`."""
+    amount = to_money(amount)
+    if isinstance(percent, bool):
+        raise ValueError("percent must be a number")
+    try:
+        percent = Decimal(str(percent))
+    except Exception:
+        raise ValueError(f"invalid percent {percent!r}") from None
+    if not percent.is_finite():
+        raise ValueError("percent must be finite")
+    if percent < 0 or percent > 100:
+        raise ValueError("percent must be between 0 and 100")
+    return amount, percent
+
+
 def apply_discount(amount, percent):
     """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    amount, percent = _parse(amount, percent)
+    return round_money(amount * (Decimal(100) - percent) / Decimal(100))
