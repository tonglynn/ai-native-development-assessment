+def refund_shipping(
+    payment,
+    amount,
+    at: datetime,
+    *,
+    approved_by=None,
+    idempotency_key=None,
+):
+    """Refund (part of) the shipping fee of a captured payment.
+
+    The amount must be positive and the total refunded may not exceed the
+    captured amount.  Once the full captured amount has been refunded the
+    payment status becomes ``"refunded"``.
+    """
+    # Idempotency is checked first, before any validation.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    captured = round_money(to_money(payment.amount))
+    already_refunded = round_money(to_money(payment.refunded_amount))
+    if already_refunded + amount > captured:
+        raise BillingError("refund_exceeds_captured", str(amount))
+
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required")
+
+    ensure_utc(at)
+
+    payment.refunded_amount = round_money(already_refunded + amount)
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        idempotency_key=idempotency_key,
+    )
+    return payment
