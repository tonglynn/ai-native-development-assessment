--- a/simkit/energy.py
+++ b/simkit/energy.py
@@ -1,3 +1,13 @@
 def energy_cost(power_watts: float, hours: float, price_per_kwh: float) -> float:
-    """Cost of running a load, rounded to 2 decimals."""
-    raise NotImplementedError
+    """Cost of running a load, rounded to 2 decimals.
+
+    Computes ``power_watts / 1000 * hours * price_per_kwh`` (kWh times price).
+    All inputs must be non-negative; otherwise ``ValueError`` is raised.
+    """
+    if power_watts < 0:
+        raise ValueError("power_watts must be non-negative")
+    if hours < 0:
+        raise ValueError("hours must be non-negative")
+    if price_per_kwh < 0:
+        raise ValueError("price_per_kwh must be non-negative")
+    return round(power_watts / 1000.0 * hours * price_per_kwh, 2)
