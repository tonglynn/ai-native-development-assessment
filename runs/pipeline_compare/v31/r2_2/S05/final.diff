+def outage_refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part of a captured payment after a service outage.
+
+    ``amount`` is added to ``payment.refunded_amount`` and the payment status
+    becomes ``"refunded"`` once the full captured amount has been refunded.
+    Returns the payment.
+    """
+    # Idempotency is checked first, before any state validation, so a retried
+    # request returns the original result instead of refunding twice.
+    if idempotency_key is not None:
+        for entry in audit.events("payment_refunded"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    captured = round_money(payment.amount)
+    already_refunded = round_money(payment.refunded_amount)
+    if already_refunded + amount > captured:
+        raise BillingError("refund_exceeds_captured", str(amount))
+
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+
+    # Normalize/validate the timestamp even though it is not stored on the
+    # payment model.
+    ensure_utc(at)
+
+    payment.refunded_amount = round_money(already_refunded + amount)
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        idempotency_key=idempotency_key,
+    )
+    return payment
