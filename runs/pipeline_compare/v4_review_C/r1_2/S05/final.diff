-def outage_refund(payment, amount, at):
-    """Refund part of a captured payment after a service outage."""
-    raise NotImplementedError
+    Adds ``amount`` to ``payment.refunded_amount`` and marks the payment as
+    ``"refunded"`` once the full captured amount has been refunded. Returns the
+    payment.
+    """
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", repr(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    captured = round_money(to_money(payment.amount))
+    already_refunded = round_money(to_money(payment.refunded_amount))
+    if already_refunded + amount > captured:
+        raise BillingError("refund_exceeds_captured", repr(amount))
+
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", repr(amount))
+
+    payment.refunded_amount = already_refunded + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        approved_by=approved_by,
+    )
+    return payment
