--- a/ledgerly/support.py
+++ b/ledgerly/support.py
@@ -1,6 +1,65 @@
 """Entry points used by the support console."""
 
+from . import audit
+from .clock import ensure_utc
+from .errors import BillingError
+from .money import ZERO, round_money, to_money
 
-def process_refund_request(payment, amount, requested_by, at):
-    """Refund part or all of a captured payment on behalf of a support agent."""
-    raise NotImplementedError
+# Finance policy FIN-2026-03: support-initiated refunds above this amount
+# require a second approver.
+APPROVAL_THRESHOLD = to_money("500.00")
+
+
+def process_refund_request(
+    payment,
+    amount,
+    requested_by,
+    at,
+    *,
+    approved_by=None,
+    idempotency_key=None,
+):
+    """Refund part or all of a captured payment on behalf of a support agent.
+
+    ``amount`` is the text the support agent typed; it is normalized to a
+    monetary value and rounded to the cent. Only captured payments can be
+    refunded, the amount must be positive, and the running total refunded may
+    never exceed the captured amount.
+    """
+    # Idempotency is checked before any validation: replaying a request must
+    # return the original record unchanged.
+    if idempotency_key is not None:
+        for event in audit.events("payment_refunded"):
+            if event.get("idempotency_key") == idempotency_key:
+                return payment
+
+    at = ensure_utc(at)
+    amount = round_money(to_money(amount))
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    refunded = to_money(payment.refunded_amount)
+    remaining = to_money(payment.amount) - refunded
+    if amount > remaining:
+        raise BillingError("refund_exceeds_captured", str(amount))
+
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required")
+
+    payment.refunded_amount = round_money(refunded + amount)
+    if payment.refunded_amount >= to_money(payment.amount):
+        payment.status = "refunded"
+
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        requested_by=requested_by,
+        approved_by=approved_by,
+        at=at,
+        idempotency_key=idempotency_key,
+    )
+    return payment
