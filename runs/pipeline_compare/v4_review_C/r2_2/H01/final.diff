-    raise NotImplementedError
+def apply_discount(amount, percent) -> Decimal:
+    """``amount`` reduced by ``percent`` percent (15 means 15% off).
+
+    The discounted price is what we charge, so it is rounded to the cent.
+    """
+    if isinstance(percent, bool) or not isinstance(percent, int):
+        raise BillingError("invalid_percent", repr(percent))
+    if percent < 0:
+        raise BillingError("negative_percent", str(percent))
+    if percent > 100:
+        raise BillingError("invalid_percent", str(percent))
+    amount = to_money(amount)
+    if amount < 0:
+        raise BillingError("negative_amount", str(amount))
+    return round_money(amount * (100 - percent) / 100)
