+def parse_amount(text: str) -> Decimal:
+    """Parse a customer-entered amount such as ``"$1,234.50"``.
+
+    Surrounding whitespace, an optional leading ``$`` and thousands
+    separators are ignored.  The text must be a valid non-negative amount
+    with at most two decimal places; otherwise ``BillingError`` is raised.
+
+    The result is a :class:`~decimal.Decimal` quantized to exactly two
+    decimal places.
+    """
+    if not isinstance(text, str):
+        raise BillingError("invalid_amount", "amount must be a string")
+
+    cleaned = text.strip()
+    if cleaned.startswith("$"):
+        cleaned = cleaned[1:].strip()
+
+    if not _AMOUNT_RE.match(cleaned):
+        raise BillingError("invalid_amount", f"invalid amount: {text!r}")
+
+    try:
+        amount = Decimal(cleaned.replace(",", ""))
+    except InvalidOperation:
+        raise BillingError("invalid_amount", f"invalid amount: {text!r}") from None
+
+    if amount < 0:
+        raise BillingError("negative_amount", f"amount must be non-negative: {text!r}")
+
+    return amount.quantize(_CENT)
