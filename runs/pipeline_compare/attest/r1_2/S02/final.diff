+"""Reseller partner commissions."""
+
+from decimal import Decimal, InvalidOperation
+
+from .errors import BillingError
+from .money import round_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+HUNDRED = Decimal("100")
+
+
+def _to_rate(rate_percent) -> Decimal:
+    """Validate and normalize a commission rate percentage."""
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_rate", f"rate must be between 0 and 50, got {rate_percent!r}")
+    if isinstance(rate_percent, float):
+        raise BillingError("float_rate", f"refusing to convert {rate_percent!r}")
+    if isinstance(rate_percent, Decimal):
+        rate = rate_percent
+    else:
+        try:
+            rate = Decimal(str(rate_percent))
+        except (InvalidOperation, ValueError):
+            raise BillingError("invalid_rate", repr(rate_percent)) from None
+    if not rate.is_finite() or rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError("invalid_rate", f"rate must be between 0 and 50, got {rate_percent!r}")
+    return rate
+
+
 def partner_commission(amount, rate_percent):
-    """Reseller commission on a sale."""
-    raise NotImplementedError
+    """Reseller commission on a sale.
+
+    Resellers earn ``rate_percent`` percent of ``amount``, rounded to the cent.
+    Rates must be between 0 and 50 inclusive.
+    """
+    amount = round_money(amount)
+    rate = _to_rate(rate_percent)
+    return round_money(amount * rate / HUNDRED)
