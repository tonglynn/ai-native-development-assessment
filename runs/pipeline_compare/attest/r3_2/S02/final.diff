+"""Reseller partner commissions."""
+
+from decimal import Decimal
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+MIN_RATE_PERCENT = Decimal("0")
+MAX_RATE_PERCENT = Decimal("50")
+HUNDRED = Decimal("100")
+
+
+def partner_commission(amount, rate_percent) -> Decimal:
+    """Return the reseller commission on a sale.
+
+    Resellers earn ``rate_percent`` percent of ``amount``, rounded to the
+    cent using the finance team's rounding policy.  ``rate_percent`` must be
+    between 0 and 50 inclusive.
+    """
+    rate = to_money(rate_percent)
+    if rate < MIN_RATE_PERCENT or rate > MAX_RATE_PERCENT:
+        raise BillingError(
+            "invalid_rate",
+            f"rate_percent must be between 0 and 50, got {rate_percent!r}",
+        )
+    sale = to_money(amount)
+    if sale < 0:
+        raise BillingError("negative_amount", repr(amount))
+    return round_money(sale * rate / HUNDRED)
