@@ -19,4 +19,13 @@
 
 def next_renewal(sub: Subscription, after: datetime) -> datetime:
     """First renewal strictly after ``after``."""
-    raise NotImplementedError
+    after = ensure_utc(after)
+    start = ensure_utc(sub.started_at)
+    length = timedelta(days=sub.period_days)
+    if after < start:
+        return start + length
+    n = (after - start) // length
+    renewal = start + n * length
+    if renewal <= after:
+        renewal += length
+    return renewal
