--- a/ledgerly/discounts.py
+++ b/ledgerly/discounts.py
@@ -1,3 +1,21 @@
+from decimal import Decimal
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+HUNDRED = Decimal("100")
+
+
 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """Return ``amount`` reduced by ``percent`` percent.
+
+    ``percent`` is a percentage (15 means 15% off). The discounted price is
+    what we charge, so it is rounded to the cent using the finance team's
+    rounding policy.
+    """
+    amount = to_money(amount)
+    percent = to_money(percent)
+    if percent < 0 or percent > HUNDRED:
+        raise BillingError("invalid_percent", str(percent))
+    discounted = amount * (HUNDRED - percent) / HUNDRED
+    return round_money(discounted)
