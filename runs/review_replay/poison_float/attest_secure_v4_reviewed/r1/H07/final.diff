-    raise NotImplementedError
+def refund_shipping(
+    payment: Payment,
+    amount,
+    at: datetime,
+    *,
+    idempotency_key=None,
+    approved_by=None,
+) -> Payment:
+    """Refund (part of) the shipping fee of a captured payment.
+
+    ``amount`` is added to ``payment.refunded_amount``.  The payment is marked
+    ``"refunded"`` once the full captured amount has been refunded.  The amount
+    must be positive and the total refunded may not exceed the captured amount.
+
+    ``idempotency_key`` guards against double refunds (INC-204): if an audit
+    entry with the same key already exists, the original result is returned
+    without applying the operation again.
+
+    Per finance policy FIN-2026-03, refunds above 500.00 require a second
+    approver supplied via ``approved_by``.
+    """
+    # Idempotency must be checked first, before any state validation.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError(
+            "approval_required",
+            f"refund of {amount} exceeds {APPROVAL_THRESHOLD}",
+        )
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    captured = round_money(payment.amount)
+    refunded = round_money(payment.refunded_amount)
+    if refunded + amount > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"{refunded + amount} > {captured}",
+        )
+
+    at = ensure_utc(at)
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=at,
+        idempotency_key=idempotency_key,
+    )
+    return payment
