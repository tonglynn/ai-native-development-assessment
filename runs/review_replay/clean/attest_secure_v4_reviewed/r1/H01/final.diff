@@ -22,5 +26,17 @@
 
 
 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent.
+
+    ``percent`` is a percentage (15 means 15% off). The discounted price is
+    what we charge, so it is rounded to the cent with the finance rounding
+    policy.
+    """
+    if isinstance(percent, bool) or not isinstance(percent, (int, Decimal)):
+        raise BillingError("invalid_percent", repr(percent))
+    if percent < 0 or percent > 100:
+        raise BillingError("invalid_percent", repr(percent))
+    value = to_money(amount)
+    if value < 0:
+        raise BillingError("negative_amount", repr(amount))
+    return round_money(value * (Decimal(100) - Decimal(percent)) / Decimal(100))
