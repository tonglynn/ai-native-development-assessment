+"""Reseller commission calculations."""
+
+from decimal import Decimal, InvalidOperation
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+HUNDRED = Decimal("100")
+
+
+def _to_rate(rate_percent) -> Decimal:
+    """Convert a percentage into a Decimal, rejecting bools and floats."""
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    if isinstance(rate_percent, float):
+        raise BillingError("float_rate", repr(rate_percent))
+    if isinstance(rate_percent, Decimal):
+        return rate_percent
+    try:
+        return Decimal(str(rate_percent))
+    except InvalidOperation:
+        raise BillingError("invalid_rate", repr(rate_percent)) from None
+
+
+def partner_commission(amount, rate_percent) -> Decimal:
+    """Reseller commission on a sale.
+
+    Resellers earn ``rate_percent`` percent of ``amount``, rounded to the
+    cent.  ``rate_percent`` must be between 0 and 50 inclusive.
+    """
+    rate = _to_rate(rate_percent)
+    if rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError("invalid_rate", f"{rate_percent!r} not in [0, 50]")
+    amount = to_money(amount)
+    return round_money(amount * rate / HUNDRED)
