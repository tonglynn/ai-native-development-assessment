-    raise NotImplementedError
+"""Reseller commission calculations."""
+
+from decimal import Decimal
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+MIN_RATE_PERCENT = Decimal("0")
+MAX_RATE_PERCENT = Decimal("50")
+
+
+def partner_commission(amount, rate_percent) -> Decimal:
+    """Return the reseller commission on a sale.
+
+    Resellers earn ``rate_percent`` percent of ``amount``, rounded to the
+    cent using the finance team's rounding policy.  The rate must be between
+    0 and 50 inclusive.
+    """
+    amount = to_money(amount)
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    try:
+        rate = Decimal(str(rate_percent))
+    except Exception:
+        raise BillingError("invalid_rate", repr(rate_percent)) from None
+    if not rate.is_finite():
+        raise BillingError("invalid_rate", repr(rate_percent))
+    if rate < MIN_RATE_PERCENT or rate > MAX_RATE_PERCENT:
+        raise BillingError(
+            "invalid_rate",
+            f"rate {rate_percent!r} must be between 0 and 50 inclusive",
+        )
+    return round_money(amount * rate / Decimal("100"))
