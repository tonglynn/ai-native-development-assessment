-    raise NotImplementedError
+def outage_refund(
+    payment: Payment,
+    amount,
+    at: datetime,
+    *,
+    idempotency_key: str | None = None,
+    approved_by: str | None = None,
+) -> Payment:
+    """Refund part of a captured payment after a service outage.
+
+    ``amount`` is added to ``payment.refunded_amount``; once the full captured
+    amount has been refunded the payment status becomes ``"refunded"``.
+    """
+    if idempotency_key is not None:
+        for event in audit.events("payment_refunded"):
+            if event.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    refunded = round_money(payment.refunded_amount)
+    captured = round_money(payment.amount)
+    if refunded + amount > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refund {amount} would exceed captured {captured} "
+            f"(already refunded {refunded})",
+        )
+
+    if amount > Decimal("1000.00") and not approved_by:
+        raise BillingError("approval_required", str(amount))
+
+    at = ensure_utc(at)
+    payment.refunded_amount = round_money(refunded + amount)
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return payment
