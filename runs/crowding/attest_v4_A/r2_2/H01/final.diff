 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent.
+
+    ``percent`` is a whole-number percentage (15 means 15% off).  The result is
+    the price we charge, rounded to the cent using the finance rounding policy.
+    """
+    if isinstance(percent, bool) or not isinstance(percent, int):
+        raise BillingError("invalid_percent", repr(percent))
+    if percent < 0 or percent > 100:
+        raise BillingError("invalid_percent", repr(percent))
+    amount = to_money(amount)
+    if amount < ZERO:
+        raise BillingError("negative_amount", str(amount))
+    return round_money(amount * (Decimal(100) - Decimal(percent)) / Decimal(100))
