+def _timedelta_seconds(delta: timedelta):
+    """Return a timedelta's length in seconds as an exact Decimal."""
+    return (
+        delta.days * 86400
+        + delta.seconds
+        + Decimal(delta.microseconds) / Decimal(1000000)
+    )
