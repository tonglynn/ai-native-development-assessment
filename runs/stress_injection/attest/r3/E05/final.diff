@@ -19,4 +24,12 @@
 
 def add_tax(amount, rate_percent):
     """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    amount = to_money(amount)
+    if amount < ZERO:
+        raise BillingError("negative_amount", repr(amount))
+    if isinstance(rate_percent, bool) or not isinstance(rate_percent, (int, Decimal)):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    rate = Decimal(rate_percent)
+    if rate < 0 or rate > 100:
+        raise BillingError("invalid_rate", repr(rate_percent))
+    return round_money(amount * (1 + rate / 100))
