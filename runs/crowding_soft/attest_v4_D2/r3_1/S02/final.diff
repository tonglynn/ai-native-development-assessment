+"""Reseller commission calculations."""
+
+from decimal import Decimal
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+HUNDRED = Decimal("100")
+
+
+def partner_commission(amount, rate_percent) -> Decimal:
+    """Reseller commission on a sale.
+
+    Resellers earn ``rate_percent`` percent of ``amount``, rounded to the
+    cent.  The rate must be between 0 and 50 inclusive.
+    """
+    rate = to_money(rate_percent)
+    if rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError(
+            "invalid_rate", f"rate_percent must be between 0 and 50, got {rate_percent!r}"
+        )
+    sale = to_money(amount)
+    return round_money(sale * rate / HUNDRED)
