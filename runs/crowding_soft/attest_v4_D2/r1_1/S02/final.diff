+"""Reseller partner commissions."""
+
+from decimal import Decimal
+
+from .errors import BillingError
+from .money import ZERO, round_money, to_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+
+
+def _to_rate(rate_percent) -> Decimal:
+    """Convert a percentage rate into a Decimal, rejecting floats."""
+    if isinstance(rate_percent, (bool, float)):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    try:
+        return Decimal(str(rate_percent))
+    except Exception:
+        raise BillingError("invalid_rate", repr(rate_percent)) from None
+
+
+def partner_commission(amount, rate_percent) -> Decimal:
+    """Reseller commission on a sale.
+
+    The reseller earns ``rate_percent`` percent of ``amount``, rounded to the
+    cent using the finance team's rounding policy.  Rates must be between 0
+    and 50 inclusive.
+    """
+    rate = _to_rate(rate_percent)
+    if rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError("invalid_rate", str(rate_percent))
+
+    amount = to_money(amount)
+    if amount < ZERO:
+        raise BillingError("negative_amount", str(amount))
+
+    return round_money(amount * rate / Decimal("100"))
