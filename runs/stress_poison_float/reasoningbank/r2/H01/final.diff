+def _to_percent(percent) -> Decimal:
+    """Validate a percentage without going through a float path."""
+    if isinstance(percent, bool) or isinstance(percent, float):
+        raise BillingError("invalid_percent", repr(percent))
+    if isinstance(percent, Decimal):
+        value = percent
+    elif isinstance(percent, int):
+        value = Decimal(percent)
+    else:
+        raise BillingError("invalid_percent", repr(percent))
+    if value < ZERO or value > HUNDRED:
+        raise BillingError("invalid_percent", repr(percent))
+    return value
+
