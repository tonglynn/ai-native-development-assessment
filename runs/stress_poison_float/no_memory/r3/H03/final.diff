@@ -13,5 +15,17 @@
 
 
 def payments_between(payments, start, end):
-    """Payments created in [start, end), oldest first."""
-    raise NotImplementedError
+    """Payments created in [start, end), oldest first.
+
+    Both boundaries are normalised to timezone-aware UTC via
+    :func:`ledgerly.clock.ensure_utc`, which rejects naive datetimes with
+    :class:`ledgerly.errors.BillingError`.
+    """
+    start = ensure_utc(start)
+    end = ensure_utc(end)
+    selected = [
+        p for p in payments
+        if p.created_at is not None
+        and start <= ensure_utc(p.created_at) < end
+    ]
+    return sorted(selected, key=lambda p: ensure_utc(p.created_at))
