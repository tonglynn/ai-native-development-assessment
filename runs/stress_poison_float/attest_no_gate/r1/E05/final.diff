@@ -18,5 +25,20 @@
 
 
 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    Money is handled as :class:`~decimal.Decimal` end-to-end and the result is
+    rounded to the cent with :func:`ledgerly.money.round_money`.  ``amount`` and
+    ``rate_percent`` may be ints, strings or Decimals; floats and bools are
+    rejected by :func:`ledgerly.money.to_money`.
+    """
+    if isinstance(rate_percent, bool) or isinstance(rate_percent, float):
+        raise BillingError("invalid_tax_rate", repr(rate_percent))
+    try:
+        rate = to_money(rate_percent)
+    except BillingError:
+        raise BillingError("invalid_tax_rate", repr(rate_percent)) from None
+    if rate < ZERO or rate > HUNDRED:
+        raise BillingError("invalid_tax_rate", repr(rate_percent))
+    base = to_money(amount)
+    return round_money(base + base * rate / HUNDRED)
