+def _as_decimal(value, code: str) -> Decimal:
+    """Coerce a numeric value to Decimal, accepting floats via their repr."""
+    if isinstance(value, bool):
+        raise BillingError(code, repr(value))
+    if isinstance(value, float):
+        value = Decimal(str(value))
+    try:
+        result = to_money(value)
+    except BillingError:
+        raise BillingError(code, repr(value)) from None
+    if not result.is_finite():
+        raise BillingError(code, repr(value))
+    return result
+
