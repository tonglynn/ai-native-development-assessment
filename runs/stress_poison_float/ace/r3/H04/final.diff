+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
+    """Credit part of an issued invoice back to the customer.
+
+    ``idempotency_key`` makes retries safe: if an audit entry with the same key
+    already exists, the original result is returned without applying the credit
+    again. Credits above the FIN-2026-03 threshold require ``approved_by``.
+    """
+    # Idempotency must be checked before any state/amount validation so that a
+    # retried call on an already-credited invoice succeeds instead of raising.
+    if idempotency_key is not None:
+        for entry in audit.events("credit_note_issued"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_total", f"{amount} > {total}")
+    if not reason:
+        raise BillingError("missing_reason", "a reason is required")
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"credit of {amount} exceeds {APPROVAL_THRESHOLD} and needs a second approver",
+        )
+
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=float(amount),
+        reason=reason,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return {"invoice_id": invoice.id, "amount": amount, "reason": reason}
