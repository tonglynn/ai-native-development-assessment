+def _to_decimal(value) -> Decimal:
+    """Convert an int, str or Decimal amount, rejecting bools and floats."""
+    if isinstance(value, bool):
+        raise BillingError("invalid_amount", repr(value))
+    if isinstance(value, float):
+        value = str(value)
+    if isinstance(value, Decimal):
+        return value
+    try:
+        return Decimal(str(value))
+    except InvalidOperation:
+        raise BillingError("invalid_amount", repr(value)) from None
+
+
+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
     """Credit part of an issued invoice back to the customer."""
-    raise NotImplementedError
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return entry["result"]
+
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+
+    amount = round_money(_to_decimal(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_total", f"{amount} > {total}")
+
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+
+    if not reason:
+        raise BillingError("reason_required", invoice.id)
+
+    result = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=float(amount),
+        reason=reason,
