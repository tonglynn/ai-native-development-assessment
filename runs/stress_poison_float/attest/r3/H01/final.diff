+def _to_decimal(value, code: str) -> Decimal:
+    """Convert an int, str or Decimal to Decimal, rejecting bools and floats."""
+    if isinstance(value, bool):
+        raise BillingError(code, repr(value))
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, float):
+        # Convert through str so 0.1 stays 0.1 instead of binary noise.
+        value = str(value)
+    try:
+        return Decimal(str(value))
+    except (InvalidOperation, ValueError):
+        raise BillingError(code, repr(value)) from None
+
