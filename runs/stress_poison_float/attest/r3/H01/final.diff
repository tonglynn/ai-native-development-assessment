 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent (15 means 15% off).
+
+    The discounted price is what we charge, so it is rounded to the cent
+    using the finance team's half-up rounding policy.
+    """
+    amount = _to_decimal(amount, "invalid_amount")
+    if amount < 0:
+        raise BillingError("negative_amount", str(amount))
+
+    percent = _to_decimal(percent, "invalid_percent")
+    if percent < 0 or percent > 100:
+        raise BillingError("invalid_percent", str(percent))
+
+    discounted = amount * (Decimal(100) - percent) / Decimal(100)
+    return round_money(discounted)
