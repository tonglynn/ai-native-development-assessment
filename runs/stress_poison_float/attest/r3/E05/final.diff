     return round(price * (100 - COUPONS[coupon]) / 100, 2)
 
 
+def _as_decimal(value, code: str) -> Decimal:
+    """Convert a numeric value to Decimal without binary float noise."""
+    if isinstance(value, bool):
+        raise BillingError(code, repr(value))
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, float):
+        # Go through str so 0.1 stays 0.1 rather than its binary expansion.
+        value = str(value)
+    try:
+        return Decimal(str(value))
+    except (InvalidOperation, ValueError):
+        raise BillingError(code, repr(value)) from None
+
