+def prorated_refund(sub: Subscription, cancel_at: datetime) -> Decimal:
+    """Refund for the unused part of the current period.
+
+    The plan price is multiplied by the fraction of the billing period that
+    remains after ``cancel_at`` (unused time divided by period length) and
+    rounded to the cent.
+    """
+    cancel_at = ensure_utc(cancel_at)
+    period_start, period_end = current_period(sub, cancel_at)
+    length = period_end - period_start
+    unused = period_end - cancel_at
+    price = to_money(sub.plan_price)
+    return round_money(price * Decimal(unused.total_seconds()) / Decimal(length.total_seconds()))
