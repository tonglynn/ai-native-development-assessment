+"""Reseller commission calculations."""
+
+from decimal import Decimal
+
+from .errors import BillingError
+from .money import ZERO, round_money, to_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+HUNDRED = Decimal("100")
+
+
+def partner_commission(amount, rate_percent) -> Decimal:
+    """Return the reseller commission on a sale.
+
+    ``rate_percent`` is the reseller's percentage of the sale and must be
+    between 0 and 50 inclusive. The result is rounded to the cent using the
+    finance team's rounding policy.
+    """
+    if isinstance(rate_percent, bool) or not isinstance(rate_percent, (int, Decimal)):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    rate = Decimal(rate_percent)
+    if rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError("invalid_rate", str(rate_percent))
+
+    amount = to_money(amount)
+    if amount < ZERO:
+        raise BillingError("negative_amount", str(amount))
+
+    return round_money(amount * rate / HUNDRED)
