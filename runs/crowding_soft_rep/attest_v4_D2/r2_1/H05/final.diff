 from datetime import datetime, timedelta
+from decimal import Decimal
 
+from . import audit
 from .clock import ensure_utc
 from .errors import BillingError
 from .models import Subscription
+from .money import round_money, to_money
+
+_APPROVAL_THRESHOLD = Decimal("500.00")
 
 
 def current_period(sub: Subscription, at: datetime) -> tuple[datetime, datetime]:
@@ -17,6 +22,40 @@
     return period_start, period_start + length
 
 
-def prorated_refund(sub: Subscription, cancel_at: datetime):
-    """Refund for the unused part of the current period."""
-    raise NotImplementedError
+def prorated_refund(
+    sub: Subscription,
+    cancel_at: datetime,
+    *,
+    idempotency_key=None,
+    approved_by=None,
+):
+    """Refund for the unused part of the current period.
+
+    The refund is the plan price multiplied by the unused fraction of the
+    billing period containing ``cancel_at`` (unused time divided by the period
+    length), rounded to the cent.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events("prorated_refund"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return entry["refund"]
+
+    cancel_at = ensure_utc(cancel_at)
+    period_start, period_end = current_period(sub, cancel_at)
+    period_length = Decimal(str((period_end - period_start).total_seconds()))
+    unused = Decimal(str((period_end - cancel_at).total_seconds()))
+    price = to_money(sub.plan_price)
+    refund = round_money(price * unused / period_length)
+
+    if refund > _APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required")
+
+    audit.record(
+        "prorated_refund",
+        subscription_id=sub.id,
+        amount=refund,
+        refund=refund,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return refund
