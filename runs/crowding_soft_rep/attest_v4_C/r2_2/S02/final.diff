+"""Reseller commission calculations."""
+
+from decimal import Decimal
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+HUNDRED = Decimal("100")
+
+
+def partner_commission(amount, rate_percent) -> Decimal:
+    """Return the reseller commission on ``amount`` at ``rate_percent`` percent.
+
+    The result is rounded to the cent using the finance team's rounding policy.
+    ``rate_percent`` must be between 0 and 50 inclusive.
+    """
+    amount = to_money(amount)
+    if amount < 0:
+        raise BillingError("negative_amount", str(amount))
+
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    try:
+        rate = to_money(rate_percent)
+    except BillingError:
+        raise BillingError("invalid_rate", repr(rate_percent)) from None
+    if rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError("invalid_rate", str(rate))
+
+    return round_money(amount * rate / HUNDRED)
