--- a/ledgerly/support.py
+++ b/ledgerly/support.py
@@ -1,6 +1,71 @@
 """Entry points used by the support console."""
 
+from . import audit
+from .clock import ensure_utc
+from .errors import BillingError
+from .money import ZERO, round_money, to_money
 
-def process_refund_request(payment, amount, requested_by, at):
-    """Refund part or all of a captured payment on behalf of a support agent."""
-    raise NotImplementedError
+# Finance policy FIN-2026-03: support-initiated refunds above this amount need
+# a second approver.
+APPROVAL_THRESHOLD = round_money("500.00")
+
+
+def process_refund_request(
+    payment,
+    amount,
+    requested_by,
+    at,
+    *,
+    approved_by=None,
+    idempotency_key=None,
+):
+    """Refund part or all of a captured payment on behalf of a support agent.
+
+    ``amount`` is the text the support agent typed; it is normalized to a
+    monetary value rounded half-up to the cent.  Only captured payments may be
+    refunded, the amount must be positive, and the running total refunded may
+    never exceed the captured amount.  The payment is mutated in place and
+    returned.
+    """
+    # Idempotency is checked before any validation so a retried request returns
+    # the original result instead of refunding twice.
+    if idempotency_key is not None:
+        for event in audit.events("payment_refunded"):
+            if event.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", repr(amount))
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    captured = to_money(payment.amount)
+    refunded = round_money(to_money(payment.refunded_amount) + amount)
+    if refunded > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refund {amount!r} would bring total to {refunded!r} "
+            f"above captured {captured!r}",
+        )
+
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required")
+
+    at = ensure_utc(at)
+
+    payment.refunded_amount = refunded
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        requested_by=requested_by,
+        approved_by=approved_by,
+        at=at,
+        idempotency_key=idempotency_key,
+    )
+    return payment
