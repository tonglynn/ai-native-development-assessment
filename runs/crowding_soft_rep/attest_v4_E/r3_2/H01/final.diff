+def apply_discount(amount, percent) -> Decimal:
+    """Return ``amount`` reduced by ``percent`` percent, rounded to the cent."""
+    price = round_money(amount)
+    discount = price * Decimal(str(percent)) / Decimal("100")
+    return round_money(price - discount)
