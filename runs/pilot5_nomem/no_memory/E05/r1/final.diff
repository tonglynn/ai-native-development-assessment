@@ -18,5 +23,13 @@
 
 
 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    ``rate_percent`` must be between 0 and 100 inclusive. The result is
+    rounded to the cent using the finance team's rounding policy.
+    """
+    amount = to_money(amount)
+    rate = to_money(rate_percent)
+    if rate < 0 or rate > 100:
+        raise BillingError("invalid_tax_rate", str(rate_percent))
+    return round_money(amount * (1 + rate / Decimal("100")))
