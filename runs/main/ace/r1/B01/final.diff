--- a/simkit/energy.py
+++ b/simkit/energy.py
@@ -1,3 +1,21 @@
+from simkit.units import watts_to_kw
+
+
 def energy_cost(power_watts: float, hours: float, price_per_kwh: float) -> float:
-    """Cost of running a load, rounded to 2 decimals."""
-    raise NotImplementedError
+    """Cost of running a load, rounded to 2 decimals.
+
+    Energy in kWh is ``power_watts / 1000 * hours``; the cost is that energy
+    multiplied by ``price_per_kwh``. Negative inputs are invalid.
+    """
+    for name, value in (
+        ("power_watts", power_watts),
+        ("hours", hours),
+        ("price_per_kwh", price_per_kwh),
+    ):
+        if isinstance(value, bool) or not isinstance(value, (int, float)):
+            raise ValueError(f"{name} must be a number")
+        if value < 0:
+            raise ValueError(f"{name} must be non-negative")
+
+    kwh = watts_to_kw(power_watts) * hours
+    return round(kwh * price_per_kwh, 2)
