+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    try:
+        amount = round_money(to_money(amount))
+    except BillingError:
+        raise BillingError("invalid_amount", repr(amount)) from None
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
