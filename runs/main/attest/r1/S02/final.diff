--- a/ledgerly/commissions.py
+++ b/ledgerly/commissions.py
@@ -1,3 +1,33 @@
+"""Reseller partner commissions."""
+
+from decimal import Decimal
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+HUNDRED = Decimal("100")
+
+
 def partner_commission(amount, rate_percent):
-    """Reseller commission on a sale."""
-    raise NotImplementedError
+    """Return the reseller commission on a sale.
+
+    The reseller earns ``rate_percent`` percent of ``amount``, rounded to the
+    cent with the finance team's rounding policy.  ``rate_percent`` must be
+    between 0 and 50 inclusive.
+    """
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    try:
+        rate = to_money(rate_percent)
+    except BillingError:
+        raise BillingError("invalid_rate", repr(rate_percent)) from None
+    if rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError("invalid_rate", repr(rate_percent))
+
+    sale = to_money(amount)
+    if sale < 0:
+        raise BillingError("negative_amount", repr(amount))
+
+    return round_money(sale * rate / HUNDRED)
