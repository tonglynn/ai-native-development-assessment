-    raise NotImplementedError
+def goodwill_credit(invoice, amount, reason, *, approved_by=None):
+    """Credit part of an issued invoice as a goodwill gesture.
+
+    Amounts above the finance-policy approval threshold require a second
+    approver via ``approved_by``.
+    """
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_total", f"{amount} > {total}")
+    if not reason:
+        raise BillingError("reason_required", invoice.id)
+    if amount > _approval_threshold() and not approved_by:
+        raise BillingError("approval_required")
+    audit.record(
+        "goodwill_credit",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        approved_by=approved_by,
+    )
+    return {"invoice_id": invoice.id, "amount": amount, "reason": reason}
