-    raise NotImplementedError
+def capture_partial(payment: Payment, amount, at: datetime, *, idempotency_key=None) -> Payment:
+    """Capture part of an authorized payment.
+
+    Captures ``amount`` of an authorized payment, sets ``payment.amount`` to the
+    captured amount, stores the capture time in ``payment.captured_at`` and sets
+    the status to ``"captured"``.  The amount must be positive and at most the
+    authorized amount; amounts with more than two decimals are rounded to the
+    cent.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events("payment_captured"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", repr(amount))
+    if payment.status != "authorized":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    if amount > payment.amount:
+        raise BillingError("amount_exceeds_authorized", repr(amount))
+
+    payment.amount = amount
+    payment.captured_at = ensure_utc(at)
+    payment.status = "captured"
+    audit.record(
+        "payment_captured",
+        payment_id=payment.id,
+        amount=amount,
+        idempotency_key=idempotency_key,
+    )
+    return payment
