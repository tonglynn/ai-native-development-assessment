+def goodwill_credit(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
+    """Credit part of an issued invoice as a goodwill gesture.
+
+    ``amount`` must be positive and must not exceed the invoice total. Only
+    issued invoices can be credited. Amounts above ``APPROVAL_THRESHOLD``
+    require ``approved_by`` to be supplied.
+    """
+    if idempotency_key is not None and idempotency_key in _IDEMPOTENT_RESULTS:
+        return _IDEMPOTENT_RESULTS[idempotency_key]
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    if amount > invoice_total(invoice):
+        raise BillingError("amount_exceeds_invoice_total", str(amount))
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+    if not reason:
+        raise BillingError("reason_required", invoice.id)
+
+    result = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
+        "goodwill_credit",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        approved_by=approved_by,
+    )
+    if idempotency_key is not None:
+        _IDEMPOTENT_RESULTS[idempotency_key] = result
+    return result
