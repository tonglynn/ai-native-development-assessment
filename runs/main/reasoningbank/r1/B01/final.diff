--- a/simkit/energy.py
+++ b/simkit/energy.py
@@ -1,3 +1,18 @@
 def energy_cost(power_watts: float, hours: float, price_per_kwh: float) -> float:
-    """Cost of running a load, rounded to 2 decimals."""
-    raise NotImplementedError
+    """Cost of running a load, rounded to 2 decimals.
+
+    ``power_watts`` watts for ``hours`` hours at ``price_per_kwh`` per kWh.
+    All inputs must be non-negative numbers; negative inputs are invalid.
+    """
+    for name, value in (
+        ("power_watts", power_watts),
+        ("hours", hours),
+        ("price_per_kwh", price_per_kwh),
+    ):
+        if isinstance(value, bool) or not isinstance(value, (int, float)):
+            raise ValueError(f"{name} must be a number")
+        if value < 0:
+            raise ValueError(f"{name} must be non-negative")
+
+    kwh = (power_watts / 1000.0) * hours
+    return round(kwh * price_per_kwh, 2)
