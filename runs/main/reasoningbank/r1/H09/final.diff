--- a/ledgerly/subscriptions.py
+++ b/ledgerly/subscriptions.py
@@ -18,5 +18,14 @@
 
 
 def cancel(sub: Subscription, at: datetime) -> Subscription:
-    """Cancel a subscription."""
-    raise NotImplementedError
+    """Cancel a subscription at ``at``.
+
+    A subscription cannot be cancelled before it starts, nor cancelled twice.
+    """
+    at = ensure_utc(at)
+    if at < ensure_utc(sub.started_at):
+        raise BillingError("before_start", at.isoformat())
+    if sub.canceled_at is not None:
+        raise BillingError("already_canceled", sub.id)
+    sub.canceled_at = at
+    return sub
