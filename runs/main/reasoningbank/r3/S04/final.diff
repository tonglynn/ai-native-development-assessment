     return float(invoice_total(invoice))
 
 
-def goodwill_credit(invoice, amount, reason):
+def goodwill_credit(invoice, amount, reason, *, approved_by=None):
     """Credit part of an issued invoice as a goodwill gesture."""
-    raise NotImplementedError
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    if not reason:
+        raise BillingError("missing_reason", "a reason is required")
+    credit = round_money(to_money(amount))
+    if credit <= ZERO:
+        raise BillingError("invalid_amount", "amount must be positive")
+    if credit > invoice_total(invoice):
+        raise BillingError("amount_exceeds_total", "amount exceeds invoice total")
+    if credit > _approval_threshold() and not approved_by:
+        raise BillingError("approval_required", "a second approver is required")
+    audit.record("goodwill_credited", invoice_id=invoice.id, amount=credit)
+    return {"invoice_id": invoice.id, "amount": credit, "reason": reason}
