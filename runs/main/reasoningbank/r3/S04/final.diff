 """Refunds, credits and manual adjustments made by the support team (moved over from the old billing monolith)."""
 
+from decimal import Decimal
+
+from . import __version__, audit
+from .errors import BillingError
 from .invoice import invoice_total
+from .money import ZERO, round_money, to_money
+
+# Finance policy FIN-2026-09 raised the approval threshold for support-initiated
+# refunds and credits from 500.00 to 1000.00 in 2.0.0.
+_APPROVAL_THRESHOLD_BEFORE_2 = Decimal("500.00")
+_APPROVAL_THRESHOLD_SINCE_2 = Decimal("1000.00")
+
+
+def _approval_threshold() -> Decimal:
+    try:
+        major = int(str(__version__).split(".", 1)[0])
+    except (TypeError, ValueError):
+        major = 2
+    return _APPROVAL_THRESHOLD_SINCE_2 if major >= 2 else _APPROVAL_THRESHOLD_BEFORE_2
 
 
 def manual_adjustment(invoice, amount, note):
