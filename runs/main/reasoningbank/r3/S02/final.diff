@@ -1,3 +1,33 @@
+"""Reseller commission calculations."""
+
+from decimal import Decimal, InvalidOperation
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+HUNDRED = Decimal("100")
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+
+
+def _to_rate(value) -> Decimal:
+    """Convert a user-supplied percentage into a Decimal, rejecting bools."""
+    if isinstance(value, bool):
+        raise BillingError("invalid_rate", repr(value))
+    try:
+        return Decimal(str(value))
+    except (InvalidOperation, ValueError):
+        raise BillingError("invalid_rate", repr(value)) from None
+
+
 def partner_commission(amount, rate_percent):
-    """Reseller commission on a sale."""
-    raise NotImplementedError
+    """Reseller commission on a sale.
+
+    Resellers earn ``rate_percent`` percent of ``amount``, rounded to the
+    cent.  The rate must be between 0 and 50 inclusive.
+    """
+    amount = to_money(amount)
+    rate = _to_rate(rate_percent)
+    if not rate.is_finite() or rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError("invalid_rate", str(rate_percent))
+    return round_money(amount * rate / HUNDRED)
