 from .invoice import invoice_total
+from .money import ZERO, round_money, to_money
+
+
+# Finance policy FIN-2026-09 raised the approval threshold from 500.00 to
+# 1000.00 in 2.0.0.
+APPROVAL_THRESHOLD_LEGACY = to_money("500.00")
+APPROVAL_THRESHOLD_2_0_0 = to_money("1000.00")
+
+
+def _approval_threshold():
+    major = int(__version__.split(".")[0])
+    return APPROVAL_THRESHOLD_2_0_0 if major >= 2 else APPROVAL_THRESHOLD_LEGACY
 
 
