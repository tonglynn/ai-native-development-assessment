 from .invoice import invoice_total
+from .money import ZERO, round_money
+
+# Finance policy FIN-2026-09: approval threshold for support-initiated
+# refunds and credits is 500.00 before 2.0.0 and 1000.00 since 2.0.0.
+APPROVAL_THRESHOLD_BEFORE_2 = Decimal("500.00")
+APPROVAL_THRESHOLD_SINCE_2 = Decimal("1000.00")
+
+
+def _approval_threshold() -> Decimal:
+    try:
+        major = int(__version__.split(".")[0])
+    except (ValueError, IndexError):
+        major = 2
+    return APPROVAL_THRESHOLD_SINCE_2 if major >= 2 else APPROVAL_THRESHOLD_BEFORE_2
 
 
