+def _parse(text: str) -> Decimal:
+    if not isinstance(text, str):
+        raise BillingError("invalid_amount", repr(text))
+    match = _AMOUNT_RE.fullmatch(text.strip())
+    if match is None:
+        raise BillingError("invalid_amount", repr(text))
+    whole, fraction = match.groups()
+    try:
+        return round_money(Decimal(whole.replace(",", "") + "." + (fraction or "0")))
+    except InvalidOperation:
+        raise BillingError("invalid_amount", repr(text)) from None
+
