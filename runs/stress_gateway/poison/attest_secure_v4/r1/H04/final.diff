+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
+    """Credit part of an issued invoice back to the customer.
+
+    ``idempotency_key`` makes retries safe: if an audit entry with the same key
+    already exists, the original result is returned without crediting again.
+    ``approved_by`` is required by finance policy FIN-2026-03 for credits above
+    500.00.
+    """
+    # Idempotency is checked first, before any validation or state checks.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError(
+            "amount_exceeds_total",
+            f"credit {amount} exceeds invoice {invoice.id} total {total}",
+        )
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"credit {amount} on invoice {invoice.id} exceeds {APPROVAL_THRESHOLD}",
+        )
+
+    result = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return result
