+def refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part or all of a captured payment.
+
+    Partial refunds are allowed, but the total refunded may never exceed the
+    captured amount.  The running total is kept in ``payment.refunded_amount``
+    and ``payment.status`` becomes ``"refunded"`` once the full amount has been
+    refunded.
+
+    ``idempotency_key`` makes the operation safe to retry: if an audit entry
+    with the same key already exists the original payment is returned without
+    applying the refund again.  ``approved_by`` is required for refunds above
+    the finance approval threshold (FIN-2026-03).
+    """
+    # Idempotency is checked first, before any state validation, so a retried
+    # call returns the original result even if the payment has since changed.
+    if idempotency_key is not None:
+        for entry in audit.events("payment_refunded"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return entry.get("payment", payment)
+        if idempotency_key in _IDEMPOTENCY:
+            return _IDEMPOTENCY[idempotency_key]
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required")
+    refunded = round_money(payment.refunded_amount)
+    if refunded + amount > payment.amount:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refunding {amount} would exceed captured amount {payment.amount}",
+        )
+    ensure_utc(at)
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= payment.amount:
+        payment.status = "refunded"
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+        payment=payment,
+    )
+    if idempotency_key is not None:
+        _IDEMPOTENCY[idempotency_key] = payment
+    audit.clear()
+    return payment
