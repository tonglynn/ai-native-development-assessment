+def refund_shipping(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund (part of) the shipping fee of a captured payment.
+
+    ``amount`` is added to ``payment.refunded_amount``.  Once the whole
+    captured amount has been refunded the payment status becomes
+    ``"refunded"``.  The payment is returned.
+
+    ``idempotency_key`` makes the operation safe to retry: if an audit entry
+    with the same key already exists the original payment is returned without
+    applying the refund again.  Refunds above 500.00 require ``approved_by``
+    (finance policy FIN-2026-03).
+    """
+    # Idempotency is checked first, before any state validation, so retries of
+    # an already-applied refund succeed even if the payment state has changed.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    at = ensure_utc(at)
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required")
+
+    captured = round_money(to_money(payment.amount))
+    already_refunded = round_money(to_money(payment.refunded_amount))
+    if already_refunded + amount > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"{already_refunded + amount} > {captured}",
+        )
+
+    payment.refunded_amount = already_refunded + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return payment
