@@ -18,5 +23,18 @@
 
 
 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The result is rounded to the cent.  ``rate_percent`` must be between
+    0 and 100 inclusive.
+    """
+    amount = to_money(amount)
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_tax_rate", str(rate_percent))
+    try:
+        rate = Decimal(str(rate_percent))
+    except InvalidOperation:
+        raise BillingError("invalid_tax_rate", str(rate_percent)) from None
+    if not rate.is_finite() or rate < 0 or rate > 100:
+        raise BillingError("invalid_tax_rate", str(rate_percent))
+    return round_money(amount * (100 + rate) / 100)
