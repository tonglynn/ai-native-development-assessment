@@ -3,11 +3,15 @@
 from .clock import utcnow
 
 _EVENTS: list[dict] = []
+_IDEMPOTENCY: dict = {}
 
 
 def record(event: str, **fields) -> dict:
     entry = {"event": event, "at": utcnow(), **fields}
     _EVENTS.append(entry)
+    key = fields.get("idempotency_key")
+    if key is not None:
+        _IDEMPOTENCY.setdefault(key, entry)
     return entry
 
 
@@ -15,5 +19,18 @@
     return [e for e in _EVENTS if event is None or e["event"] == event]
 
 
+def idempotent_result(key):
+    """Return the audit entry recorded for ``key``, if any."""
+    if key is None:
+        return None
+    entry = _IDEMPOTENCY.get(key)
+    if entry is not None:
+        return entry
+    for e in _EVENTS:
+        if e.get("idempotency_key") == key:
+            return e
+    return None
+
+
 def clear() -> None:
     _EVENTS.clear()
