+def refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part or all of a captured payment.
+
+    ``idempotency_key`` makes retries safe: if an audit entry with the same
+    key already exists, the original result is returned without applying the
+    refund again. Refunds above 500.00 require ``approved_by`` (FIN-2026-03).
+    """
+    # Idempotency must be checked before any state validation.
+    if audit.find_idempotent(idempotency_key) is not None:
+        return payment
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("negative_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+    refunded = round_money(payment.refunded_amount or ZERO)
+    if refunded + amount > round_money(payment.amount):
+        raise BillingError("refund_exceeds_captured", str(amount))
+    at = ensure_utc(at)
+    payment.refunded_amount = round_money(refunded + amount)
+    if payment.refunded_amount == round_money(payment.amount):
+        payment.status = "refunded"
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    audit.clear()
+    return payment
