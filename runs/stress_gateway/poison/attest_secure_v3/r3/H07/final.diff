+def _find_idempotent_result(idempotency_key):
+    """Return the payment recorded for ``idempotency_key``, if any."""
+    if idempotency_key is None:
+        return None
+    for entry in audit.events("shipping_refunded"):
+        if entry.get("idempotency_key") == idempotency_key:
+            return entry.get("payment")
+    return None
+
+
+def refund_shipping(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund (part of) the shipping fee of a captured payment.
+
+    ``idempotency_key`` makes the operation safe to retry: a repeated key
+    returns the original payment without applying the refund again.
+    ``approved_by`` is required by finance policy FIN-2026-03 for refunds
+    above 500.00.
+    """
+    # Idempotency is checked first, before any state validation.
+    existing = _find_idempotent_result(idempotency_key)
+    if existing is not None:
+        return existing
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"refund of {amount} exceeds {APPROVAL_THRESHOLD} and needs a second approver",
+        )
+    captured = round_money(payment.amount)
+    refunded = round_money(payment.refunded_amount)
+    if refunded + amount > captured:
+        raise BillingError(
+            "over_refund",
+            f"refunding {amount} would exceed captured {captured} (already refunded {refunded})",
+        )
+    at = ensure_utc(at)
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+        payment=payment,
+    )
+    return payment
