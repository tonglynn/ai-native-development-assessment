 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent.
+
+    The discounted price is what we charge, so it is rounded to the cent
+    using the finance team's half-up rounding policy.
+    """
+    amount = to_money(amount)
+    if amount < 0:
+        raise BillingError("negative_amount", f"amount must be non-negative: {amount}")
+    percent = to_money(percent)
+    if percent < 0 or percent > HUNDRED:
+        raise BillingError("invalid_percent", f"percent must be between 0 and 100: {percent}")
+    discounted = amount * (HUNDRED - percent) / HUNDRED
+    return round_money(discounted)
