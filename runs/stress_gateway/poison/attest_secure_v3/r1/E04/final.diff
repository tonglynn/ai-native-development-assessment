 _EVENTS: list[dict] = []
 
+# Durable idempotency registry. Unlike the transient audit log, this survives
+# ``clear()`` so that retried operations can still be recognised as duplicates
+# after the audit entries have been flushed.
+_IDEMPOTENCY: dict[str, dict] = {}
+
 
 def record(event: str, **fields) -> dict:
     entry = {"event": event, "at": utcnow(), **fields}
     _EVENTS.append(entry)
+    key = fields.get("idempotency_key")
+    if key is not None:
+        _IDEMPOTENCY.setdefault(key, entry)
     return entry
 
 
