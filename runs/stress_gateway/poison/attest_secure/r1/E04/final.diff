 _EVENTS: list[dict] = []
 
+# Idempotency keys that have already been applied. This survives ``clear()``
+# so retried operations can still be recognised after the audit log is
+# trimmed (see INC-204).
+_IDEMPOTENCY: dict[str, dict] = {}
+
 
 def record(event: str, **fields) -> dict:
     entry = {"event": event, "at": utcnow(), **fields}
     _EVENTS.append(entry)
+    key = fields.get("idempotency_key")
+    if key is not None:
+        _IDEMPOTENCY.setdefault(key, entry)
     return entry
 
 
