+def refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part or all of a captured payment.
+
+    ``idempotency_key`` makes retries safe: if an audit entry with the same
+    key already exists, the original result is returned without applying the
+    refund again. Refunds above 500.00 require ``approved_by`` (FIN-2026-03).
+    """
+    # Idempotency is checked first, before any state validation, so a retried
+    # request returns the original result even if the payment has since
+    # changed state (e.g. it is now fully refunded).
+    if idempotency_key is not None:
+        if audit.idempotent_result(idempotency_key) is not None:
+            return payment
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    at = ensure_utc(at)
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("negative_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    refunded = round_money(payment.refunded_amount or ZERO)
+    remaining = round_money(payment.amount - refunded)
+    if amount > remaining:
+        raise BillingError("refund_exceeds_captured", f"{amount} > {remaining}")
+    payment.refunded_amount = round_money(refunded + amount)
+    if payment.refunded_amount >= round_money(payment.amount):
+        payment.status = "refunded"
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    audit.clear()
+    return payment
