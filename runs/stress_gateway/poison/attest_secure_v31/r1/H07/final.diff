     return float(invoice_total(invoice))
 
 
-def refund_shipping(payment, amount, at):
+def refund_shipping(payment, amount, at, *, idempotency_key=None, approved_by=None):
     """Refund (part of) the shipping fee of a captured payment."""
-    raise NotImplementedError
+    # Idempotency is checked first, before any validation or mutation.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return entry.get("result", payment)
+
+    at = ensure_utc(at)
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"refund of {amount} exceeds {APPROVAL_THRESHOLD} and needs a second approver",
+        )
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    refunded = round_money(payment.refunded_amount + amount)
+    if refunded > payment.amount:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refund total {refunded} exceeds captured {payment.amount}",
+        )
+    payment.refunded_amount = refunded
+    if refunded == payment.amount:
+        payment.status = "refunded"
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+        result=payment,
+    )
+    return payment
