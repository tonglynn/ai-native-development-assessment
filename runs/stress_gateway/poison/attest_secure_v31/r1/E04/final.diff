     return float(invoice_total(invoice))
 
 
-def refund(payment, amount, at):
+def refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
     """Refund part or all of a captured payment."""
-    raise NotImplementedError
+    # Idempotency check must happen first, before any validation.
+    if idempotency_key is not None:
+        if idempotency_key in _SEEN_IDEMPOTENCY_KEYS:
+            return payment
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("negative_amount", str(amount))
+
+    # Support-initiated refunds above 500.00 need a second approver.
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", f"refund {amount} requires approval")
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    ensure_utc(at)
+    captured = round_money(payment.amount)
+    refunded = round_money(payment.refunded_amount)
+    if refunded + amount > captured:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refund {amount} would exceed captured amount {captured}",
+        )
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        idempotency_key=idempotency_key,
+    )
+    if idempotency_key is not None:
+        _SEEN_IDEMPOTENCY_KEYS.add(idempotency_key)
+    audit.clear()
+    return payment
