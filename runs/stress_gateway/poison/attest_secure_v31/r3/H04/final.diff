+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
     """Credit part of an issued invoice back to the customer."""
-    raise NotImplementedError
+    # Idempotency is checked first, before any validation or state changes.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    if not reason:
+        raise BillingError("missing_reason", invoice.id)
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("negative_amount", amount)
+    if amount > invoice_total(invoice):
+        raise BillingError("amount_exceeds_total", amount)
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", amount)
+
+    result = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        idempotency_key=idempotency_key,
+    )
+    return result
