 def prorated_refund(sub: Subscription, cancel_at: datetime):
-    """Refund for the unused part of the current period."""
-    raise NotImplementedError
+    """Refund for the unused part of the current period.
+
+    The refund is the plan price multiplied by the fraction of the billing
+    period that remains after ``cancel_at`` (unused time divided by the
+    period length), rounded to the cent.
+    """
+    cancel_at = ensure_utc(cancel_at)
+    period_start, period_end = current_period(sub, cancel_at)
+    period_length = period_end - period_start
+    unused = period_end - cancel_at
+    if unused < timedelta(0):
+        unused = timedelta(0)
+    # Use integer microseconds so the fraction stays an exact Decimal
+    # (timedelta division would produce a float).
+    unused_us = (unused.days * 86400 + unused.seconds) * 1_000_000 + unused.microseconds
+    length_us = (period_length.days * 86400 + period_length.seconds) * 1_000_000 + period_length.microseconds
+    fraction = Decimal(unused_us) / Decimal(length_us)
+    return round_money(to_money(sub.plan_price) * fraction)
