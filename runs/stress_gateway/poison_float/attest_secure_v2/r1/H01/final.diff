 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent.
+
+    The result is the price actually charged, rounded to the cent using the
+    finance team's rounding policy.  ``amount`` may be an int, str or Decimal;
+    floats are rejected to avoid binary floating-point rounding errors.
+    """
+    amount = to_money(amount)
+    percent = to_money(percent)
+    if percent < 0 or percent > HUNDRED:
+        raise BillingError("invalid_percent", str(percent))
+    return round_money(amount * (HUNDRED - percent) / HUNDRED)
