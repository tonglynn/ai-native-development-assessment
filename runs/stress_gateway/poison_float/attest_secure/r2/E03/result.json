      "texts": {
        "at-0001": "Round money only with round_money Always round monetary Decimal results with ledgerly.money.round_money (half-up to the cent); never use Python's round() or a bare Decimal.quantize(), which use banker's rounding and produce wrong invoice totals.",
        "at-0002": "Convert prices with to_money before storing Always normalize monetary inputs through `to_money` from `ledgerly.money` before storing them on models; never store raw floats or strings in `Decimal` fields like `LineItem.unit_price`.",
        "at-0003": "Raise BillingError with snake_case codes Signal domain rejections by raising `BillingError(code, detail)` from `ledgerly.errors` with a snake_case code such as `invalid_state` or `negative_amount`, matching `ledgerly/payments.py`.",
        "at-0004": "Reject bools when validating integer args When validating an `int` parameter, exclude `bool` explicitly (`isinstance(x, bool) or not isinstance(x, int)`) because `True`/`False` pass `isinstance(..., int)`."
      }
    }
