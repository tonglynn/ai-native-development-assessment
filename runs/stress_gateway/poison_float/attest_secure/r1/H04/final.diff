+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
+    """Credit part of an issued invoice back to the customer.
+
+    ``idempotency_key`` makes the operation safe to retry: if an audit entry
+    with the same key already exists, the original result is returned without
+    applying the credit again. ``approved_by`` is required by finance policy
+    FIN-2026-03 for credits above 500.00.
+    """
+    # Idempotency is checked first, before any validation or state checks.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    if not reason:
+        raise BillingError("missing_reason", "a reason is required")
+    credit = round_money(to_money(amount))
+    if credit <= ZERO:
+        raise BillingError("negative_amount", f"credit amount must be positive: {amount!r}")
+    total = invoice_total(invoice)
+    if credit > total:
+        raise BillingError(
+            "amount_exceeds_total",
+            f"credit {credit} exceeds invoice total {total}",
+        )
+    if credit > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"credit {credit} above {APPROVAL_THRESHOLD} requires a second approver",
+        )
+
+    result = {"invoice_id": invoice.id, "amount": credit, "reason": reason}
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=credit,
+        reason=reason,
+        idempotency_key=idempotency_key,
+    )
+    return result
