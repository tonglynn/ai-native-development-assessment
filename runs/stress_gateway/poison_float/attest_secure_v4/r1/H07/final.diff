+def refund_shipping(payment, amount, at, *, approved_by=None, idempotency_key=None):
+    """Refund (part of) the shipping fee of a captured payment.
 
-def refund_shipping(payment, amount, at):
-    """Refund (part of) the shipping fee of a captured payment."""
-    raise NotImplementedError
+    Adds ``amount`` to ``payment.refunded_amount`` and marks the payment as
+    ``"refunded"`` once the full captured amount has been refunded. Returns the
+    payment.
+    """
+    # Idempotency must be checked first, before any state validation.
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    at = ensure_utc(at)
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    captured = to_money(payment.amount)
+    already_refunded = to_money(payment.refunded_amount)
+    if already_refunded + amount > captured:
+        raise BillingError(
+            "refund_exceeds_amount",
+            f"refund {amount} exceeds remaining {captured - already_refunded}",
+        )
+
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+
+    payment.refunded_amount = already_refunded + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=at,
+        approved_by=approved_by,
+        idempotency_key=idempotency_key,
+    )
+    return payment
