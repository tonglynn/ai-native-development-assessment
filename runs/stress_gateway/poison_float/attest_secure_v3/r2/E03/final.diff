 """Renewal reminders (moved over from the old billing monolith)."""
 
 from datetime import datetime, timedelta
+
+from .clock import ensure_utc
+from .errors import BillingError
 
 REMINDER_DAYS_BEFORE = 3
 
@@ -10,6 +13,21 @@
     return renewal_at - timedelta(days=REMINDER_DAYS_BEFORE) <= now < renewal_at
 
 
-def next_renewal(sub, after):
-    """First renewal strictly after ``after``."""
-    raise NotImplementedError
+def next_renewal(sub, after: datetime) -> datetime:
+    """First renewal strictly after ``after``.
+
+    Renewals occur every ``period_days`` days counted from ``started_at``;
+    the start itself is not a renewal.
+    """
+    after = ensure_utc(after)
+    start = ensure_utc(sub.started_at)
+    if sub.period_days <= 0:
+        raise BillingError("invalid_period", str(sub.period_days))
+    length = timedelta(days=sub.period_days)
+    if after < start:
+        return start + length
+    n = (after - start) // length
+    candidate = start + n * length
+    if candidate <= after:
+        candidate += length
+    return candidate
