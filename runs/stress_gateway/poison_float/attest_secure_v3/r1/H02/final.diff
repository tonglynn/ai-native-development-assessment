+from .errors import BillingError
+from .money import round_money, to_money
+
+# A non-negative amount with optional thousands separators and at most two
+# decimal places.  The integer part is either a plain run of digits or groups
+# of exactly three digits separated by commas (no leading zeros beyond a
+# single "0").
+_AMOUNT_RE = re.compile(
+    r"""
+    (?:\d{1,3}(?:,\d{3})+|\d+)   # integer part, optionally comma-grouped
+    (?:\.\d{1,2})?               # optional fractional part, max two places
+    """,
+    re.VERBOSE,
+)
 
 
