+def parse_amount(text: str) -> Decimal:
+    """Parse a customer-entered amount such as "$1,234.50".
+
+    Surrounding whitespace, an optional leading ``$`` and thousands separators
+    are ignored.  The text must be a valid non-negative amount with at most two
+    decimal places; otherwise :class:`~ledgerly.errors.BillingError` is raised.
+
+    The result is a :class:`~decimal.Decimal` quantized to exactly two decimal
+    places, matching the rest of ledgerly's money handling.
+    """
+    if not isinstance(text, str):
+        raise BillingError("invalid_amount", repr(text))
+
+    cleaned = text.strip()
+    if cleaned.startswith("$"):
+        cleaned = cleaned[1:]
+
+    if not _AMOUNT_RE.match(cleaned):
+        raise BillingError("invalid_amount", repr(text))
+
+    try:
+        amount = Decimal(cleaned.replace(",", ""))
+    except InvalidOperation:
+        raise BillingError("invalid_amount", repr(text)) from None
+
+    if not amount.is_finite() or amount < 0:
+        raise BillingError("invalid_amount", repr(text))
+
+    return amount.quantize(CENT)
