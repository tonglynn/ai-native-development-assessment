+def _find_idempotent_refund(idempotency_key):
+    """Return the audit entry for a prior refund with this key, if any."""
+    if idempotency_key is None:
+        return None
+    for entry in audit.events("payment_refunded"):
+        if entry.get("idempotency_key") == idempotency_key:
+            return entry
+    return None
+
+
+def refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part or all of a captured payment.
+
+    Only captured payments can be refunded. Partial refunds are allowed, but
+    the total refunded must never exceed the captured amount. The running
+    total is kept in ``payment.refunded_amount`` and ``payment.status`` is set
+    to ``"refunded"`` once the full amount has been refunded.
+
+    ``idempotency_key`` makes the operation safe to retry: if an audit entry
+    with the same key already exists, the original result is returned without
+    applying the refund again.
+
+    Refunds above 500.00 require a second approver (``approved_by``), per
+    finance policy FIN-2026-03.
+    """
+    # Idempotency is checked first, before any state validation, so retries of
+    # an already-applied refund succeed even though the payment state changed.
+    prior = _find_idempotent_refund(idempotency_key)
+    if prior is not None:
+        return payment
+
+    at = ensure_utc(at)
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required")
+
+    refunded = round_money(payment.refunded_amount)
+    if refunded + amount > payment.amount:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refund of {amount} would exceed captured amount {payment.amount}",
+        )
+
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= payment.amount:
+        payment.status = "refunded"
+
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return payment
