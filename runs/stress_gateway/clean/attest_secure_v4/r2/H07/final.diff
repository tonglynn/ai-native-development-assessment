+def refund_shipping(payment, amount, at, *, approved_by=None, idempotency_key=None):
+    """Refund (part of) the shipping fee of a captured payment.
+
+    ``amount`` is added to ``payment.refunded_amount``; once the full captured
+    amount has been refunded the payment status becomes ``"refunded"``.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return entry.get("result")
+
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > _APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    at = ensure_utc(at)
+
+    captured = round_money(to_money(payment.amount))
+    already_refunded = round_money(to_money(payment.refunded_amount))
+    new_refunded = round_money(already_refunded + amount)
+    if new_refunded > captured:
+        raise BillingError("refund_exceeds_captured", str(new_refunded))
+
+    payment.refunded_amount = new_refunded
+    if new_refunded == captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        approved_by=approved_by,
+        idempotency_key=idempotency_key,
+        result=payment,
+    )
+    return payment
