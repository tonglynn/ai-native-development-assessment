 """Plan prices and coupons (moved over from the old billing monolith)."""
+
+from decimal import Decimal, ROUND_HALF_UP
+
+from ledgerly.errors import BillingError
 
 PLAN_PRICES = {"starter": 9.99, "team": 49.0, "business": 199.0}
 COUPONS = {"WELCOME10": 10, "PARTNER25": 25}
@@ -18,5 +22,24 @@
 
 
 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The result is rounded to the cent using half-up rounding.  ``amount`` may
+    be an int, float, Decimal or numeric string; the return value is a
+    ``Decimal`` quantized to two decimal places.
+    """
+    if isinstance(amount, bool) or isinstance(rate_percent, bool):
+        raise BillingError("invalid_amount", "amount and rate must be numbers")
+    try:
+        amount_d = Decimal(str(amount))
+        rate_d = Decimal(str(rate_percent))
+    except Exception:
+        raise BillingError("invalid_amount", "amount and rate must be numbers") from None
+    if not amount_d.is_finite() or not rate_d.is_finite():
+        raise BillingError("invalid_amount", "amount and rate must be finite")
+    if amount_d < 0:
+        raise BillingError("negative_amount", "amount must not be negative")
+    if rate_d < 0 or rate_d > 100:
+        raise BillingError("invalid_rate", "tax rate must be between 0 and 100 inclusive")
+    gross = amount_d * (Decimal(1) + rate_d / Decimal(100))
+    return gross.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
