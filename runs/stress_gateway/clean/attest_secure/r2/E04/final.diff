+def _find_idempotent_refund(idempotency_key):
+    """Return the payment recorded for ``idempotency_key``, if any."""
+    if idempotency_key is None:
+        return None
+    for entry in audit.events("payment_refunded"):
+        if entry.get("idempotency_key") == idempotency_key:
+            return entry.get("payment")
+    return None
+
+
+def refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part or all of a captured payment.
+
+    ``idempotency_key`` makes the operation safe to retry: a repeated key
+    returns the original payment without applying the refund again.
+    Refunds above ``APPROVAL_THRESHOLD`` require ``approved_by``.
+    """
+    # Idempotency is checked before any validation so retries of an already
+    # applied operation succeed even if the payment state has since changed.
+    existing = _find_idempotent_refund(idempotency_key)
+    if existing is not None:
+        return existing
+
+    at = ensure_utc(at)
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"refund of {amount} requires a second approver",
+        )
+    if payment.status not in ("captured", "refunded"):
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    refunded = round_money(payment.refunded_amount)
+    if refunded + amount > payment.amount:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refund of {amount} would exceed captured amount {payment.amount}",
+        )
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= payment.amount:
+        payment.status = "refunded"
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+        payment=payment,
+    )
+    return payment
