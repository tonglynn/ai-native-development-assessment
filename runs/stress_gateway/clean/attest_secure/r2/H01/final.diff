@@ -22,5 +25,16 @@
 
 
 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """Return ``amount`` reduced by ``percent`` percent, rounded to the cent.
+
+    ``percent`` is a percentage (15 means 15% off). The result is the
+    discounted price we charge, so it is rounded to the cent.
+    """
+    amount = to_money(amount)
+    if amount < 0:
+        raise BillingError("negative_amount", str(amount))
+    if isinstance(percent, bool) or not isinstance(percent, (int, float)):
+        raise BillingError("invalid_percent", repr(percent))
+    if percent < 0 or percent > 100:
+        raise BillingError("invalid_percent", repr(percent))
+    return round_money(amount * (100 - percent) / 100)
