+def issue_credit_note(invoice, amount, reason, *, approved_by=None, idempotency_key=None):
+    """Credit part of an issued invoice back to the customer.
+
+    The amount must be positive and must not exceed the invoice total, and
+    only issued invoices can be credited. Credits above the approval threshold
+    require a second approver (FIN-2026-03).
+
+    When ``idempotency_key`` is supplied, a prior credit note recorded with the
+    same key is returned unchanged instead of applying the operation again
+    (INC-204).
+    """
+    if idempotency_key is not None:
+        for entry in audit.events("credit_note_issued"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_total", f"{amount} > {total}")
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+    result = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        idempotency_key=idempotency_key,
+    )
+    return result
