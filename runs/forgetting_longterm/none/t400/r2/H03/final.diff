 def payments_between(payments, start, end):
-    """Payments created in [start, end), oldest first."""
-    raise NotImplementedError
+    """Payments created in [start, end), oldest first.
+
+    Both boundaries are normalised to timezone-aware UTC; naive datetimes are
+    rejected with ``BillingError``.
+    """
+    start = ensure_utc(start)
+    end = ensure_utc(end)
+    in_window = []
+    for payment in payments:
+        created_at = payment.created_at
+        if created_at is None:
+            continue
+        created_at = ensure_utc(created_at)
+        if start <= created_at < end:
+            in_window.append((created_at, payment))
+    in_window.sort(key=lambda item: item[0])
+    return [payment for _, payment in in_window]
