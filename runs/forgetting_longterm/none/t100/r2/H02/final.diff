@@ -16,5 +22,28 @@
 
 
 def parse_amount(text: str):
-    """Parse a customer-entered amount such as "$1,234.50"."""
-    raise NotImplementedError
+    """Parse a customer-entered amount such as "$1,234.50".
+
+    Surrounding whitespace, an optional leading ``$`` and thousands
+    separators are ignored.  Only non-negative amounts with at most two
+    decimal places are accepted; anything else raises ``BillingError``.
+    """
+    if not isinstance(text, str):
+        raise BillingError("invalid_amount", "amount must be text")
+
+    cleaned = text.strip()
+    if cleaned.startswith("$"):
+        cleaned = cleaned[1:]
+
+    if not _AMOUNT_RE.match(cleaned):
+        raise BillingError("invalid_amount", f"invalid amount: {text!r}")
+
+    try:
+        amount = Decimal(cleaned.replace(",", ""))
+    except InvalidOperation:
+        raise BillingError("invalid_amount", f"invalid amount: {text!r}") from None
+
+    if amount < 0:
+        raise BillingError("negative_amount", f"negative amount: {text!r}")
+
+    return amount.quantize(Decimal("0.01"))
