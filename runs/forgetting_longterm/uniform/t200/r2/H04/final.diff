-def issue_credit_note(invoice, amount, reason):
+def _parse(invoice, amount, reason):
+    """Validate and normalize credit note inputs."""
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    if amount > invoice_total(invoice):
+        raise BillingError("amount_exceeds_total", str(amount))
+    if not isinstance(reason, str) or not reason.strip():
+        raise BillingError("reason_required", repr(reason))
+    if len(reason) > MAX_REASON_LENGTH:
+        raise BillingError("reason_too_long", str(len(reason)))
+    return amount, reason
+
+
+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
     """Credit part of an issued invoice back to the customer."""
-    raise NotImplementedError
+    if idempotency_key is not None:
+        for entry in audit.events("credit_note_issued"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+    amount, reason = _parse(invoice, amount, reason)
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required")
+    note = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
