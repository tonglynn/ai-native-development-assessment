+def _parse(value) -> datetime:
+    """Normalize a window boundary to an aware UTC datetime."""
+    return ensure_utc(value)
+
+
 def payments_between(payments, start, end):
     """Payments created in [start, end), oldest first."""
-    raise NotImplementedError
+    start = _parse(start)
+    end = _parse(end)
+    window = [
+        p for p in payments
+        if p.created_at is not None and start <= _parse(p.created_at) < end
+    ]
+    return sorted(window, key=lambda p: _parse(p.created_at))
