+def _find_idempotent_result(idempotency_key):
+    """Return the result recorded for ``idempotency_key``, if any."""
+    if idempotency_key is None:
+        return None
+    for entry in audit.events("invoice_written_off"):
+        if entry.get("idempotency_key") == idempotency_key:
+            return {
+                "invoice_id": entry["invoice_id"],
+                "amount": entry["amount"],
+                "reason": entry["reason"],
+            }
+    return None
+
