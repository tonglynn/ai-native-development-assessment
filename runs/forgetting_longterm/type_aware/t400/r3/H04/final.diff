-def issue_credit_note(invoice, amount, reason):
+def _parse(invoice, amount, reason):
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    if amount > invoice_total(invoice):
+        raise BillingError("amount_exceeds_invoice_total", str(amount))
+    if not isinstance(reason, str) or not reason.strip():
+        raise BillingError("invalid_reason", "a reason is required")
+    if len(reason) > MAX_REASON_LENGTH:
+        raise BillingError("invalid_reason", f"reason exceeds {MAX_REASON_LENGTH} characters")
+    return amount, reason
+
+
+def _find_by_idempotency_key(idempotency_key):
+    if idempotency_key is None:
+        return None
+    for entry in audit.events():
+        if entry.get("idempotency_key") == idempotency_key:
+            return entry.get("result")
+    return None
+
+
+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
     """Credit part of an issued invoice back to the customer."""
-    raise NotImplementedError
+    existing = _find_by_idempotency_key(idempotency_key)
+    if existing is not None:
+        return existing
+    amount, reason = _parse(invoice, amount, reason)
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+    result = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
