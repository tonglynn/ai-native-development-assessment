+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
+    """Credit part of an issued invoice back to the customer.
+
+    ``idempotency_key`` makes the operation safe to retry: if an audit entry
+    with the same key already exists, the original result is returned without
+    applying the credit again (see INC-204).
+
+    ``approved_by`` is required by finance policy FIN-2026-03 for credits
+    above 500.00.
+    """
+    # Idempotency must be checked before any state validation so that a retry
+    # of an already-applied operation returns the original result even if the
+    # invoice state has since changed.
+    if idempotency_key is not None:
+        for entry in audit.events("credit_note_issued"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_invoice_total", f"{amount} > {total}")
+    if not reason:
+        raise BillingError("reason_required", invoice.id)
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return {"invoice_id": invoice.id, "amount": amount, "reason": reason}
