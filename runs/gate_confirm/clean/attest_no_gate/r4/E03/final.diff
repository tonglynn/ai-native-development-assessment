--- a/ledgerly/renewals.py
+++ b/ledgerly/renewals.py
@@ -1,6 +1,9 @@
 """Renewal reminders (moved over from the old billing monolith)."""
 
 from datetime import datetime, timedelta
+
+from .clock import ensure_utc
+from .errors import BillingError
 
 REMINDER_DAYS_BEFORE = 3
 
@@ -11,5 +14,20 @@
 
 
 def next_renewal(sub, after):
-    """First renewal strictly after ``after``."""
-    raise NotImplementedError
+    """First renewal strictly after ``after``.
+
+    Renewals occur every ``period_days`` days counted from ``started_at``;
+    the start itself is not a renewal.
+    """
+    after = ensure_utc(after)
+    start = ensure_utc(sub.started_at)
+    period_days = sub.period_days
+    if isinstance(period_days, bool) or not isinstance(period_days, int):
+        raise BillingError("invalid_period", repr(period_days))
+    if period_days <= 0:
+        raise BillingError("invalid_period", repr(period_days))
+    length = timedelta(days=period_days)
+    if after < start:
+        return start + length
+    n = (after - start) // length + 1
+    return start + n * length
