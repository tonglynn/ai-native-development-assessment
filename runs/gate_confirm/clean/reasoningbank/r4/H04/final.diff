+def issue_credit_note(invoice, amount, reason, *, idempotency_key=None, approved_by=None):
+    """Credit part of an issued invoice back to the customer.
+
+    The amount must be positive and must not exceed the invoice total, and
+    only issued invoices can be credited.  Money-moving operations are
+    idempotent: passing the same ``idempotency_key`` again returns the
+    original credit note without recording a second one.
+
+    Per finance policy FIN-2026-03, credits above 500.00 require a second
+    approver; pass ``approved_by`` for those amounts.
+    """
+    # Idempotency is checked first, before any state validation, so a retry
+    # of an already-applied credit succeeds even if the invoice has since
+    # changed state.
+    if idempotency_key is not None:
+        for entry in audit.events("credit_note_issued"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_invoice_total", f"{amount} > {total}")
+    if amount > Decimal("500.00") and not approved_by:
+        raise BillingError("approval_required")
+
+    note = {"invoice_id": invoice.id, "amount": amount, "reason": reason}
+    audit.record(
+        "credit_note_issued",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return note
