@@ -19,4 +24,14 @@
 
 def add_tax(amount, rate_percent):
     """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    amount = round_money(amount)
+    if isinstance(rate_percent, Decimal):
+        rate = rate_percent
+    else:
+        try:
+            rate = Decimal(str(rate_percent))
+        except InvalidOperation:
+            raise BillingError("invalid_rate", repr(rate_percent)) from None
+    if rate < ZERO or rate > 100:
+        raise BillingError("invalid_rate", str(rate))
+    return round_money(amount * (100 + rate) / 100)
