 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The result is rounded to the cent using the finance team's rounding
+    policy.  ``rate_percent`` must be between 0 and 100 inclusive.
+    """
+    amount = to_money(amount)
+    if amount < ZERO:
+        raise BillingError("negative_amount", str(amount))
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_tax_rate", repr(rate_percent))
+    try:
+        rate = Decimal(str(rate_percent))
+    except (InvalidOperation, ValueError):
+        raise BillingError("invalid_tax_rate", repr(rate_percent)) from None
+    if not rate.is_finite() or rate < ZERO or rate > HUNDRED:
+        raise BillingError("invalid_tax_rate", str(rate))
+    return round_money(amount * (HUNDRED + rate) / HUNDRED)
