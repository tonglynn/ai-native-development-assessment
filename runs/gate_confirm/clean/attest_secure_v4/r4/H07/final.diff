-    raise NotImplementedError
+def refund_shipping(
+    payment,
+    amount,
+    at: datetime,
+    *,
+    idempotency_key=None,
+    approved_by=None,
+):
+    """Refund (part of) the shipping fee of a captured payment.
+
+    ``amount`` is added to ``payment.refunded_amount``.  Once the whole
+    captured amount has been refunded the payment status becomes
+    ``"refunded"``.  The payment is returned.
+
+    ``idempotency_key`` makes the operation safe to retry: a repeat with the
+    same key returns the original payment without applying the refund again
+    (INC-204).  Refunds above ``APPROVAL_THRESHOLD`` require ``approved_by``
+    (FIN-2026-03).
+    """
+    # Idempotency is checked first, before any state validation.
+    if idempotency_key is not None:
+        for entry in audit.events("shipping_refunded"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = round_money(amount)
+    at = ensure_utc(at)
+
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    captured = round_money(payment.amount)
+    already_refunded = round_money(payment.refunded_amount)
+    if already_refunded + amount > captured:
+        raise BillingError("refund_exceeds_captured", str(amount))
+
+    payment.refunded_amount = already_refunded + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        refunded_amount=payment.refunded_amount,
+        at=at,
+        idempotency_key=idempotency_key,
+        approved_by=approved_by,
+    )
+    return payment
