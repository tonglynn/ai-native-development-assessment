+def refund(payment, amount, at, *, idempotency_key=None, approved_by=None):
+    """Refund part or all of a captured payment.
+
+    ``idempotency_key`` makes retries safe: if an audit entry with the same
+    key already exists, the original payment is returned without applying the
+    refund again. Refunds above 500.00 require ``approved_by`` (FIN-2026-03).
+    """
+    # Idempotency must be checked before any state validation so that a
+    # retried request returns the original result even if the payment has
+    # since changed (e.g. it is now fully refunded).
+    if idempotency_key is not None:
+        for entry in audit.events():
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    at = ensure_utc(at)
+    amount = round_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError(
+            "approval_required",
+            f"refund of {amount} requires a second approver",
+        )
+    refunded = round_money(payment.refunded_amount)
+    if refunded + amount > payment.amount:
+        raise BillingError(
+            "refund_exceeds_captured",
+            f"refund {amount} would exceed captured amount {payment.amount}",
+        )
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= payment.amount:
+        payment.status = "refunded"
+    audit.record(
+        "payment_refunded",
+        payment_id=payment.id,
+        amount=amount,
+        at=at,
+        idempotency_key=idempotency_key,
+    )
+    return payment
