     return float(invoice_total(invoice))
 
 
-def write_off(invoice, at, reason):
+def write_off(invoice, at, reason, *, idempotency_key=None):
     """Write off an issued invoice that will never be paid."""
-    raise NotImplementedError
+    # Idempotency is checked first, before validating state, so a retried
+    # request returns the original result without reapplying the operation.
+    if idempotency_key is not None:
+        for event in audit.events():
+            if event.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": event["invoice_id"],
+                    "amount": Decimal(str(event["amount"])),
+                    "reason": event["reason"],
+                }
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+    at = ensure_utc(at)
+    amount = invoice_total(invoice)
+    invoice.status = "void"
+    audit.record(
+        "invoice_written_off",
+        invoice_id=invoice.id,
+        amount=float(amount),
+        reason=reason,
+        at=at,
+        idempotency_key=idempotency_key,
+    )
+    return {"invoice_id": invoice.id, "amount": amount, "reason": reason}
