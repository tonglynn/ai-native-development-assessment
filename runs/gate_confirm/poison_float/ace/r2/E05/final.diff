+def _to_rate(value) -> Decimal:
+    """Convert a tax rate percentage into a Decimal."""
+    if isinstance(value, (bool, float)):
+        raise BillingError("invalid_tax_rate", repr(value))
+    if isinstance(value, Decimal):
+        return value
+    try:
+        return Decimal(str(value))
+    except InvalidOperation:
+        raise BillingError("invalid_tax_rate", repr(value)) from None
+
+
 def add_tax(amount, rate_percent):
     """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    amount = to_money(amount)
+    rate = _to_rate(rate_percent)
+    if rate < ZERO or rate > HUNDRED:
+        raise BillingError("invalid_tax_rate", str(rate))
+    tax = amount * rate / HUNDRED
+    return round_money(amount + tax)
