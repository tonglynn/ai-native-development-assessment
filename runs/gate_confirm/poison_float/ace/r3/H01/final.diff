 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent, rounded to the cent."""
+    if isinstance(percent, bool) or not isinstance(percent, (int, Decimal)):
+        raise BillingError("invalid_rate", f"percent must be an int or Decimal, got {percent!r}")
+    if not (0 <= percent <= 100):
+        raise BillingError("invalid_rate", f"percent must be between 0 and 100, got {percent!r}")
