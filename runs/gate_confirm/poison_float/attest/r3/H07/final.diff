-    raise NotImplementedError
+def _as_money(amount) -> Decimal:
+    """Normalize floats via str before to_money (to_money rejects floats)."""
+    if isinstance(amount, float):
+        amount = Decimal(str(amount))
+    return round_money(to_money(amount))
+
+
+def refund_shipping(payment, amount, at, *, approved_by=None, idempotency_key=None):
+    """Refund (part of) the shipping fee of a captured payment.
+
+    Adds ``amount`` to ``payment.refunded_amount`` and marks the payment
+    ``"refunded"`` once the full captured amount has been refunded.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events("shipping_refunded"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return payment
+
+    amount = _as_money(amount)
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    if payment.status != "captured":
+        raise BillingError("invalid_state", f"payment {payment.id} is {payment.status}")
+
+    captured = _as_money(payment.amount)
+    refunded = _as_money(payment.refunded_amount)
+    if refunded + amount > captured:
+        raise BillingError("refund_exceeds_captured", str(amount))
+
+    if amount > APPROVAL_THRESHOLD and approved_by is None:
+        raise BillingError("approval_required")
+
+    at = ensure_utc(at)
+    payment.refunded_amount = refunded + amount
+    if payment.refunded_amount >= captured:
+        payment.status = "refunded"
+
+    audit.record(
+        "shipping_refunded",
+        payment_id=payment.id,
+        amount=float(amount),
+        refunded_amount=float(payment.refunded_amount),
+        approved_by=approved_by,
+        idempotency_key=idempotency_key,
+        at=at,
+    )
+    return payment
