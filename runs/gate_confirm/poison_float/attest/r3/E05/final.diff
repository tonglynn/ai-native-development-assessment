 PLAN_PRICES = {"starter": 9.99, "team": 49.0, "business": 199.0}
 COUPONS = {"WELCOME10": 10, "PARTNER25": 25}
@@ -18,5 +23,18 @@
 
 
 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The result is rounded to the cent using the finance team's half-up
+    rounding policy.  ``rate_percent`` must be between 0 and 100 inclusive.
+    """
+    if isinstance(rate_percent, bool) or not isinstance(rate_percent, (int, float, Decimal)):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    rate = Decimal(str(rate_percent))
+    if rate < 0 or rate > 100:
+        raise BillingError("invalid_rate", repr(rate_percent))
+    # ``to_money`` rejects floats, so normalize float amounts via str first.
+    if isinstance(amount, float):
+        amount = Decimal(str(amount))
+    base = to_money(amount)
+    return round_money(base * (1 + rate / 100))
