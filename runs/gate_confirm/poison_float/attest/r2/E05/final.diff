     return round(price * (100 - COUPONS[coupon]) / 100, 2)
 
 
+def _to_rate(value) -> Decimal:
+    """Convert a tax rate into a Decimal, rejecting bools and bad values."""
+    if isinstance(value, bool):
+        raise BillingError("invalid_tax_rate", repr(value))
+    if isinstance(value, Decimal):
+        rate = value
+    else:
+        try:
+            rate = Decimal(str(value))
+        except (InvalidOperation, ValueError):
+            raise BillingError("invalid_tax_rate", repr(value)) from None
+    if not rate.is_finite():
+        raise BillingError("invalid_tax_rate", repr(value))
+    return rate
+
+
 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The result is rounded to the cent using the finance team's half-up
+    rounding policy.  ``rate_percent`` must be between 0 and 100 inclusive.
+    """
+    rate = _to_rate(rate_percent)
+    if rate < 0 or rate > 100:
+        raise BillingError("invalid_tax_rate", str(rate_percent))
+    base = to_money(amount)
+    return round_money(base * (1 + rate / 100))
