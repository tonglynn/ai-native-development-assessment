 def add_tax(amount, rate_percent):
-    """Gross amount including ``rate_percent`` percent tax."""
-    raise NotImplementedError
+    """Gross amount including ``rate_percent`` percent tax.
+
+    The result is rounded to the cent using the finance team's half-up
+    rounding policy.  ``rate_percent`` must be between 0 and 100 inclusive.
+    """
+    amount = _as_decimal(amount)
+    rate = _as_decimal(rate_percent)
+    if rate < ZERO or rate > HUNDRED:
+        raise BillingError("invalid_tax_rate", str(rate))
+    tax = amount * rate / HUNDRED
+    return round_money(amount + tax)
