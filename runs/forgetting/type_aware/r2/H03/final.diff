@@ -13,5 +15,19 @@
 
 
 def payments_between(payments, start, end):
-    """Payments created in [start, end), oldest first."""
-    raise NotImplementedError
+    """Payments created in [start, end), oldest first.
+
+    ``start`` and ``end`` must be timezone-aware datetimes; they are
+    normalised to UTC via :func:`ledgerly.clock.ensure_utc`.
+    """
+    start = ensure_utc(start)
+    end = ensure_utc(end)
+    return sorted(
+        (
+            p
+            for p in payments
+            if p.created_at is not None
+            and start <= ensure_utc(p.created_at) < end
+        ),
+        key=lambda p: ensure_utc(p.created_at),
+    )
