 def apply_discount(amount, percent):
-    """``amount`` reduced by ``percent`` percent."""
-    raise NotImplementedError
+    """``amount`` reduced by ``percent`` percent, rounded to the cent."""
+    price = to_money(amount)
+    if price < 0:
+        raise BillingError("negative_amount", repr(amount))
+    rate = _parse_percent(percent)
+    return round_money(price * (Decimal(100) - rate) / Decimal(100))
