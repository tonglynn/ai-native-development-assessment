+"""Reseller partner commissions."""
+
+from decimal import Decimal, InvalidOperation
+
+from .errors import BillingError
+from .money import round_money, to_money
+
+MIN_RATE = Decimal("0")
+MAX_RATE = Decimal("50")
+
+
+def _to_rate(rate_percent) -> Decimal:
+    """Convert a percentage into a Decimal, rejecting bools and bad values."""
+    if isinstance(rate_percent, bool):
+        raise BillingError("invalid_rate", repr(rate_percent))
+    if isinstance(rate_percent, float):
+        raise BillingError("float_rate", f"refusing to convert {rate_percent!r}")
+    if isinstance(rate_percent, Decimal):
+        rate = rate_percent
+    else:
+        try:
+            rate = Decimal(str(rate_percent))
+        except InvalidOperation:
+            raise BillingError("invalid_rate", repr(rate_percent)) from None
+    if not rate.is_finite():
+        raise BillingError("invalid_rate", repr(rate_percent))
+    if rate < MIN_RATE or rate > MAX_RATE:
+        raise BillingError("invalid_rate", repr(rate_percent))
+    return rate
+
+
 def partner_commission(amount, rate_percent):
-    """Reseller commission on a sale."""
-    raise NotImplementedError
+    """Reseller commission on a sale.
+
+    Resellers earn ``rate_percent`` percent of each sale, rounded to the cent
+    using the finance team's rounding policy.  Rates must be between 0 and 50
+    inclusive.
+    """
+    rate = _to_rate(rate_percent)
+    sale = to_money(amount)
+    return round_money(sale * rate / Decimal("100"))
