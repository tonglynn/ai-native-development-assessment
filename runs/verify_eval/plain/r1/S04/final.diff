     return float(invoice_total(invoice))
 
 
-def goodwill_credit(invoice, amount, reason):
-    """Credit part of an issued invoice as a goodwill gesture."""
-    raise NotImplementedError
+APPROVAL_THRESHOLD = to_money("1000.00")
+
+
+def goodwill_credit(invoice, amount, reason, *, approved_by=None, idempotency_key=None):
+    """Credit part of an issued invoice as a goodwill gesture.
+
+    ``amount`` must be positive and must not exceed the invoice total. Only
+    issued invoices can be credited. Returns a dict with ``invoice_id``,
+    ``amount`` and ``reason``.
+    """
+    if idempotency_key is not None:
+        for entry in audit.events("goodwill_credit"):
+            if entry.get("idempotency_key") == idempotency_key:
+                return {
+                    "invoice_id": entry["invoice_id"],
+                    "amount": entry["amount"],
+                    "reason": entry["reason"],
+                }
+
+    if invoice.status != "issued":
+        raise BillingError("invalid_state", f"invoice {invoice.id} is {invoice.status}")
+
+    amount = round_money(to_money(amount))
+    if amount <= ZERO:
+        raise BillingError("non_positive_amount", str(amount))
+
+    total = invoice_total(invoice)
+    if amount > total:
+        raise BillingError("amount_exceeds_total", str(amount))
+
+    if not reason:
+        raise BillingError("reason_required", repr(reason))
+
+    if amount > APPROVAL_THRESHOLD and not approved_by:
+        raise BillingError("approval_required", str(amount))
+
+    audit.record(
+        "goodwill_credit",
+        invoice_id=invoice.id,
+        amount=amount,
+        reason=reason,
+        idempotency_key=idempotency_key,
+    )
+    return {"invoice_id": invoice.id, "amount": amount, "reason": reason}
