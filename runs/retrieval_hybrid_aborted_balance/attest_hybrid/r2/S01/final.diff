+from decimal import Decimal
+
+from .errors import BillingError
+from .money import ZERO, round_money, to_money
+
+RATE = Decimal("0.029")
+FIXED = Decimal("0.30")
+
+
+def processing_fee(amount) -> Decimal:
+    """Card processing fee: 2.9% of the amount plus a fixed 0.30.
+
+    The result is rounded to the cent using the finance rounding policy.
+    Amounts must be positive.
+    """
+    value = to_money(amount)
+    if value <= ZERO:
+        raise BillingError("negative_amount", f"amount must be positive: {value}")
+    return round_money(value * RATE + FIXED)
