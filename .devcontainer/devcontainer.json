{
  "name": "earned-memory",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "pip install --user -r requirements.txt",
  "containerEnv": {
    "MSWEA_COST_TRACKING": "ignore_errors"
  },
  "secrets": {
    "DEEPSEEK_API_KEY": {
      "description": "DeepSeek API key. Stored as a Codespaces secret and never committed to the repository."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
